{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Resident Evil 5",
        "exe": [
          "re5dx9.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2,
      "unit": "x",
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "slider"
      ]
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto",
          "label": "@HudAspectRatioConstraint.auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "min": -1,
      "max": 1000,
      "unit": "fps",
      "special": [
        { "value": -1, "label": "@FPSLimit.monitor" },
        { "value": 0, "label": "@FPSLimit.unlimited" }
      ],
      "suggestions": [
        { "value": 30 },
        { "value": 60 },
        { "value": 120 },
        { "value": 144 },
        { "value": 240 }
      ],
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 60,
        "enhanced": 60
      }
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 2,
      "choices": [
        {
          "value": 1,
          "label": "@WindowMode.windowed"
        },
        {
          "value": 2,
          "label": "@WindowMode.borderless"
        }
      ],
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": 1,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.LightSyncRGB",
      "type": "bool",
      "default": 1,
      "label": "@LightSyncRGB",
      "description": "@LightSyncRGB.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.ColorFilter",
      "type": "bool",
      "default": 1,
      "label": "@ColorFilter",
      "description": "@ColorFilter.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 1,
        "recommended": 1,
        "enhanced": 0
      }
    },
    {
      "id": "MAIN.ModernControls",
      "type": "bool",
      "default": 0,
      "label": "@ModernControls",
      "description": "@ModernControls.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.MovingTurnSpeed",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 3.0,
      "step": 0.1,
      "decimals": 1,
      "unit": "x",
      "label": "@MovingTurnSpeed",
      "description": "@MovingTurnSpeed.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "slider"
      ]
    },
    {
      "id": "MAIN.ForceLaserSight",
      "type": "bool",
      "default": 0,
      "label": "@ForceLaserSight",
      "description": "@ForceLaserSight.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.KnifeParry",
      "type": "bool",
      "default": 0,
      "label": "@KnifeParry",
      "description": "@KnifeParry.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        { "value": "auto", "label": "@TextLanguage.auto" },
        { "value": "en", "label": "English" },
        { "value": "fr", "label": "Français" },
        { "value": "de", "label": "Deutsch" },
        { "value": "it", "label": "Italiano" },
        { "value": "es", "label": "Español" }
      ],
      "label": "@TextLanguage",
      "description": "@TextLanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "menu"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": 0,
      "label": "@checkupdates",
      "description": "@checkupdates.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
