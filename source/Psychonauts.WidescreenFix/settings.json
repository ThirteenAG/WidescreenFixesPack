{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Psychonauts",
        "exe": [
          "Psychonauts.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    }
  ],
  "settings": [
    {
      "id": "MAIN.WindowMode",
      "type": "int",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@windowmode.fullscreen"
        },
        {
          "value": 1,
          "label": "@windowmode.windowed"
        },
        {
          "value": 2,
          "label": "@windowmode.borderless"
        }
      ]
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        }
      ],
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ],
      "presets": {
        "vanilla": "Auto",
        "recommended": "Auto",
        "enhanced": "Auto"
      }
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": 1,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@FMVWidescreenMode.original"
        },
        {
          "value": 1,
          "label": "@FMVWidescreenMode.fill"
        },
        {
          "value": 2,
          "label": "@FMVWidescreenMode.stretch"
        }
      ],
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    }
  ]
}
