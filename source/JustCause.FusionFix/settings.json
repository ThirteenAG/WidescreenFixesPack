{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Just Cause",
        "exe": [
          "JustCause.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "game",
      "title": "@page.game",
      "section": "gameplay"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    }
  ],
  "settings": [
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@FMVMode",
      "description": "@FMVMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        { "value": 0, "label": "@FMVMode.original" },
        { "value": 1, "label": "@FMVMode.fit" }
      ],
      "presets": { "vanilla": 0, "recommended": 1, "enhanced": 1 }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "suggestions": [
        "Auto",
        "4:3",
        "16:9",
        "21:9",
        "32:9"
      ],
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@MAIN.WindowMode.0"
        },
        {
          "value": 1,
          "label": "@MAIN.WindowMode.1"
        },
        {
          "value": 2,
          "label": "@MAIN.WindowMode.2"
        }
      ],
      "label": "@MAIN.WindowMode",
      "description": "@MAIN.WindowMode.description",
      "page": "display",
      "apply": "restart"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "apply": "live"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "min": 30,
      "max": 1000,
      "unit": "fps",
      "special": [
        {
          "value": 0,
          "label": "@MAIN.FPSLimit.unlimited"
        },
        {
          "value": -1,
          "label": "@fps.monitor"
        }
      ],
      "suggestions": [
        {
          "value": 30
        },
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 165
        },
        {
          "value": 240
        }
      ],
      "label": "@MAIN.FPSLimit",
      "description": "@MAIN.FPSLimit.description",
      "page": "display",
      "apply": "live",
      "control": [
        "cycler",
        "dropdown"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 60,
        "enhanced": 60
      }
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@MAIN.PauseOnFocusLoss",
      "description": "@MAIN.PauseOnFocusLoss.description",
      "page": "display",
      "apply": "live"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@CutsceneBorders.off"
        },
        {
          "value": 1,
          "label": "@CutsceneBorders.letterbox"
        },
        {
          "value": 2,
          "label": "@CutsceneBorders.pillarbox"
        },
        {
          "value": 3,
          "label": "@CutsceneBorders.both"
        }
      ],
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@CheckForUpdates",
      "description": "@CheckForUpdates.description",
      "page": "game",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
