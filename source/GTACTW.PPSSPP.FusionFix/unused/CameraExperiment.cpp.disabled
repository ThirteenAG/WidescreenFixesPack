// The PRX loader owns this memory. The game still manages its resource heap,
// eviction, asynchronous reads and decompression; none of these buffers is
// passed to a different allocator for disposal.
constexpr unsigned cacheBytes = 32 * 1024 * 1024;
constexpr unsigned loadingBufferBytes = 423936, loadingBuffers = 24;
constexpr unsigned maxSectors = 169, modelSlots = 4096, nativeSlots = 2048;
constexpr unsigned rendererLimit = 2048;
alignas(1024) uint8_t resourceCache[cacheBytes];
// Cached render geometry uses a different heap from compressed resources.
// Keeping the original 1.8 MB heap defeats the larger streaming cache.
alignas(1024) uint8_t geometryCache[12 * 1024 * 1024];
// The stock 612 KB display lists sit immediately before other game data.
// Extended scenery can overflow them even with free resource/geometry RAM.
constexpr unsigned displayListBytes = 4 * 1024 * 1024;
alignas(64) uint8_t displayLists[2][displayListBytes];
injector::hook_back<int()> beginFrame;
alignas(64) uint8_t loadingData[loadingBuffers][loadingBufferBytes];
bool loadingUsed[loadingBuffers];
alignas(16) uint8_t modelPool[modelSlots * 256], blockPool[192 * 104], proxies[4096 * 8];
uintptr_t modelTable[modelSlots];
struct alignas(4) Sector {
    uint8_t native[1892];
    uint16_t models[nativeSlots];
    uint16_t visibility[nativeSlots];
    unsigned boxCount;
    bool assigned, mapped, ready;
    unsigned blockedKeys;
    uintptr_t address() { return reinterpret_cast<uintptr_t>(native); }
    unsigned x() const { return native[14]; }
    unsigned y() const { return native[15]; }
};
Sector sectors[maxSectors];
struct ModelKey {
    int x, y, z;
    uint16_t resource, angle, attributes, users;
};
ModelKey keys[modelSlots - nativeSlots];
constexpr unsigned hashBuckets = 4096;
uint16_t hashHeads[hashBuckets], hashNext[modelSlots - nativeSlots];
unsigned liveKeys, freeCursor, pollCursor, frame;
Sector* currentSector;
bool streaming;
#ifndef NDEBUG
bool diagnosticNativeGrid;
#endif
int drawDistance = 300;
uintptr_t world;
injector::hook_back<void(uintptr_t)> processWorld;
injector::hook_back<int(uintptr_t)> unloadWorld, resetWorld, prepareWorld;
injector::hook_back<uintptr_t(uintptr_t, unsigned)> modelLookup;
injector::hook_back<int(uintptr_t, unsigned, unsigned)> modelRelease;
SafetyMipsInline lookupHook, releaseHook;
injector::hook_back<void(uintptr_t, uintptr_t)> releaseBuffer;
injector::hook_back<void(uintptr_t)> linkModel;
injector::hook_back<void(uintptr_t, uintptr_t)> addWaterModel;
unsigned duplicateLinks;
// The native swap manager has only 24 entries and no full-table check.
// A streamed model can have several sector owners, so index its variant
// state by the instance pool slot rather than registering each owner.
struct Variant {
    uintptr_t model;
    uint8_t loading, active, group, mask;
};
Variant variants[modelSlots];
uint16_t variantSlots[modelSlots];
unsigned variantCount;
using InitPool = int(*)(uintptr_t, const char*, void*, unsigned, unsigned);

template<uintptr_t Site, class Function> Function Native() {
    return reinterpret_cast<Function>(Address<Site>());
}
void LinkModel(uintptr_t model);
bool ExtraModel(uintptr_t model) {
    if (model < uintptr_t(modelPool) || model >= uintptr_t(modelPool) + sizeof(modelPool)) return false;
    // Native and extra instances share the pool; ownership is identified by
    // the expanded ID table, not the allocator's physical slot number.
    for (unsigned i = nativeSlots; i < modelSlots; ++i) if (modelTable[i] == model) return true;
    return false;
}
void AddWaterModel(uintptr_t manager, uintptr_t model) {
    // This list feeds cached water intersections, not the main scenery
    // buckets. Distant instances must not generate those expensive caches.
    if (!ExtraModel(model)) addWaterModel.fun(manager, model);
}
Variant& ModelVariant(uintptr_t model) {
    return variants[(model - reinterpret_cast<uintptr_t>(modelPool)) / 256];
}
bool VariantActive(uintptr_t manager, const Variant& entry) {
    const auto selected = at<unsigned>(manager + 4 + 4 * entry.group);
    return selected < 4 && (entry.mask & (1u << selected));
}
int RegisterVariant(uintptr_t manager, uintptr_t model) {
    auto& entry = ModelVariant(model);
    if (entry.model) return entry.active;
    entry.model = model;
    variantSlots[variantCount++] = uint16_t(&entry - variants);
    const auto groups = at<uintptr_t>(manager);
    const auto resource = at<unsigned>(model + 32);
    for (unsigned group = 0; group < 24; ++group)
        for (unsigned variant = 0; variant < 4; ++variant)
            for (unsigned i = 0; i < 8; ++i)
                if (at<uint16_t>(groups + group * 64 + variant * 16 + i * 2) == resource) {
                    entry.group = uint8_t(group);
                    entry.mask |= uint8_t(1u << variant);
                }
    if (VariantActive(manager, entry)) {
        at<uint8_t>(manager + 292) = 1;
        entry.loading = entry.active = 1;
    } else {
        auto& hidden = at<uint8_t>(model + 193);
        if (!hidden++ && at<uintptr_t>(model)) Native<0x08AE51FC, void(*)(uintptr_t)>()(model);
        Native<0x08A5E0F0, void(*)(uintptr_t, uintptr_t)>()(Address<0x08C1CDD0>(), model);
    }
    return entry.active;
}
void RemoveVariant(uintptr_t, uintptr_t model) {
    auto& entry = ModelVariant(model);
    if (!entry.model) return;
    const auto slot = unsigned(&entry - variants);
    for (unsigned i = 0; i < variantCount; ++i) if (variantSlots[i] == slot) {
        variantSlots[i] = variantSlots[--variantCount];
        break;
    }
    entry = {};
}
void ResetVariants(uintptr_t) {
    for (unsigned i = 0; i < variantCount; ++i) variants[variantSlots[i]] = {};
    variantCount = 0;
}
void SelectVariant(uintptr_t manager, unsigned group, unsigned selected) {
    for (unsigned i = 0; i < variantCount; ++i) {
        auto& entry = variants[variantSlots[i]];
        if (entry.group == group && selected < 4 && (entry.mask & (1u << selected)) && !entry.active)
            entry.loading = 1;
    }
    at<uint8_t>(manager + 292) = 1;
    at<unsigned>(manager + 4 + group * 4) = selected;
}
void ProcessVariants(uintptr_t manager) {
    if (!at<uint8_t>(manager + 292)) return;
    bool pending = false;
    for (unsigned i = 0; i < variantCount; ++i) {
        auto& entry = variants[variantSlots[i]];
        if (entry.loading) {
            if (!Native<0x08AE50C4, int(*)(uintptr_t)>()(entry.model)) pending = true;
            else entry.loading = 0;
        }
    }
    if (pending) return;
    at<uint8_t>(manager + 292) = 0;
    for (unsigned i = 0; i < variantCount; ++i) {
        auto& entry = variants[variantSlots[i]];
        const bool active = VariantActive(manager, entry);
        if (active == bool(entry.active)) continue;
        entry.active = active;
        auto& hidden = at<uint8_t>(entry.model + 193);
        if (active) {
            if (!--hidden) {
                const auto resource = Native<0x089F72CC, uintptr_t(*)(uintptr_t, unsigned)>()(
                    Address<0x08C109E0>(), at<unsigned>(entry.model + 32));
                if (at<uint16_t>(at<uintptr_t>(resource) + 8) == 5) LinkModel(entry.model);
            }
            AddWaterModel(Address<0x08C1CDD0>(), entry.model);
        } else {
            if (!hidden++ && at<uintptr_t>(entry.model)) Native<0x08AE51FC, void(*)(uintptr_t)>()(entry.model);
            Native<0x08A5E0F0, void(*)(uintptr_t, uintptr_t)>()(Address<0x08C1CDD0>(), entry.model);
        }
    }
}
void PollResources(uintptr_t manager) {
    // The stock top-down camera drains all outstanding reads synchronously.
    // Extra sectors must stay asynchronous so driving cannot wait for the
    // entire distant resource queue in the middle of a frame.
    if (!currentSector) Native<0x089F6E24, void(*)(uintptr_t)>()(manager);
}
void PollTextures(uintptr_t manager) {
    if (!currentSector) Native<0x08A88CA8, void(*)(uintptr_t)>()(manager);
}
int ClipWaterGeometry(uintptr_t model, uintptr_t data) {
    // The water pass has stack arrays for 3,096 triangle flags and 1,024
    // crossing edges. Large distant meshes can exceed both limits when
    // viewed from street level. Their normal scenery draw stays intact;
    // omit only the unsafe cached water intersection.
    if (at<uint16_t>(data + 6) > 3096 || at<uint16_t>(data + 18) > 1024) {
#ifndef NDEBUG
        static unsigned reports;
        if (reports++ < 8) logger.WriteF("Oversize water mesh %08X resource %u triangles %u edges %u", unsigned(model),
            at<unsigned>(model + 32), unsigned(at<uint16_t>(data + 6)), unsigned(at<uint16_t>(data + 18)));
#endif
        return 0;
    }
    return Native<0x089491A8, int(*)(uintptr_t, uintptr_t)>()(model, data);
}
void InitializeDisplayLists() {
    const auto table = Address<0x08B58FBC>();
    for (unsigned i = 0; i < 2; ++i) at<uintptr_t>(table + 4 * i) = uintptr_t(displayLists[i]);
}
int BeginFrame() {
    const int result = beginFrame.fun();
    const auto context = Address<0x08C11EC0>();
    const auto base = at<uintptr_t>(context + 4);
    // Native BeginFrame emits its initial commands and performs the normal
    // double-buffer fence. Only the end of its command/vertex arena changes.
    at<uintptr_t>(context + 8) = base + displayListBytes;
    at<uintptr_t>(context + 12) = base + displayListBytes;
    return result;
}
void LinkModel(uintptr_t model) {
    if (at<uintptr_t>(model)) {
        if (++duplicateLinks <= 8) logger.WriteF("Duplicate scenery link %08X refs %u/%u caller %08X extra %08X", unsigned(model),
            unsigned(at<uint8_t>(model + 192)), unsigned(at<uint8_t>(model + 193)),
            unsigned(uintptr_t(__builtin_return_address(0))), unsigned(uintptr_t(currentSector)));
        return;
    }
    linkModel.fun(model);
}
struct Context {
    Sector* previous;
    Sector& sector;
    unsigned resource = 0xFFFF;
    uint16_t saved[nativeSlots];
    uintptr_t Boxes() const {
        // The resource heap can compact between calls, even while a sector
        // owns a reference. Resolve the current data instead of retaining a
        // pointer into the heap across frames or allocations.
        const auto entry = Native<0x089F72CC, uintptr_t(*)(uintptr_t, unsigned)>()(Address<0x08C109E0>(), resource);
        const auto data = at<uintptr_t>(at<uintptr_t>(entry) + 16);
        const unsigned quadrant = sector.native[12];
        return data + 72 + (quadrant ? at<unsigned>(data + 4 * quadrant - 4) : 0);
    }
    explicit Context(Sector& value) : previous(currentSector), sector(value) {
        currentSector = &sector;
        if (!sector.mapped) return;
        // Native and extra sectors can share a decompressed resource. Their
        // model instances differ, so their visibility refcounts must also
        // remain independent, including while the native grid catches up.
        resource = at<unsigned>(sector.address() + 8);
        Native<0x089F7788, int(*)(uintptr_t, unsigned)>()(Address<0x08C109E0>(), resource);
        const auto boxes = Boxes();
        for (unsigned i = 0; i < sector.boxCount; ++i) {
            auto& flag = at<uint16_t>(boxes + 16 * i + 14);
            saved[i] = flag;
            flag = sector.visibility[i];
        }
    }
    ~Context() {
        if (resource != 0xFFFF) {
            const auto boxes = Boxes();
            for (unsigned i = 0; i < sector.boxCount; ++i) {
                auto& flag = at<uint16_t>(boxes + 16 * i + 14);
                sector.visibility[i] = flag;
                flag = saved[i];
            }
            // Keep the resource alive until its shared flags are restored.
            Native<0x089F77F4, void(*)(uintptr_t, unsigned)>()(Address<0x08C109E0>(), resource);
        }
        currentSector = previous;
    }
};
unsigned Hash(const ModelKey& key) {
    unsigned h = unsigned(key.x) * 0x9E3779B1u ^ unsigned(key.y) * 0x85EBCA77u ^ unsigned(key.z);
    h ^= unsigned(key.resource) * 0xC2B2AE3Du ^ unsigned(key.angle) * 31u ^ key.attributes;
    return (h ^ (h >> 16)) & (hashBuckets - 1);
}
void DropMapping(Sector& sector) {
    for (const auto slot : sector.models) {
        if (slot < nativeSlots || slot >= modelSlots) continue;
        const unsigned i = slot - nativeSlots;
        auto& key = keys[i];
        if (!key.users || --key.users) continue;
        auto* link = &hashHeads[Hash(key)];
        while (*link != 0xFFFF && *link != i) link = &hashNext[*link];
        if (*link == i) *link = hashNext[i];
        --liveKeys;
    }
    sector.mapped = false;
}
void Unlink(Sector& sector) {
    const auto p = sector.address();
    const auto next = at<uintptr_t>(p), previous = at<uintptr_t>(p + 4);
    if (next) {
        at<uintptr_t>(next + 4) = previous;
        at<uintptr_t>(previous) = next;
        at<uintptr_t>(p) = 0;
    }
}
void Release(Sector& sector) {
    if (!sector.assigned) return;
    Unlink(sector);
    {
        Context context(sector);
        Native<0x089F1F3C, void(*)(uintptr_t, unsigned)>()(sector.address(), 1);
    }
    if (sector.mapped) DropMapping(sector);
    sector.assigned = sector.ready = false;
}
void ReleaseAll() {
    for (auto& sector : sectors) Release(sector);
    world = 0;
}
bool Equal(const ModelKey& a, const ModelKey& b) {
    return a.x == b.x && a.y == b.y && a.z == b.z &&
           a.resource == b.resource && a.angle == b.angle && a.attributes == b.attributes;
}
unsigned FindModel(const ModelKey& key) {
    const auto bucket = Hash(key);
    for (unsigned i = hashHeads[bucket]; i != 0xFFFF; i = hashNext[i])
        if (Equal(keys[i], key)) return i + nativeSlots;
    // Normal streaming can replace all nine nearby sectors after this call.
    // Reserve the game's entire native instance pool, plus spare render slots,
    // rather than checking only the current renderer count.
    const auto header = at<uintptr_t>(world + 452);
    const unsigned reserve = at<uint16_t>(header + 6) + 128u;
    if (reserve >= rendererLimit || liveKeys >= rendererLimit - reserve) return modelSlots;
    for (unsigned n = 0; n < modelSlots - nativeSlots; ++n) {
        const unsigned i = (freeCursor + n) % (modelSlots - nativeSlots);
        if (!keys[i].users && !modelTable[i + nativeSlots]) {
            keys[i] = key;
            hashNext[i] = hashHeads[bucket];
            hashHeads[bucket] = uint16_t(i);
            ++liveKeys;
            freeCursor = (i + 1) % (modelSlots - nativeSlots);
            return i + nativeSlots;
        }
    }
    return modelSlots;
}
// Sector records reuse 11-bit instance IDs outside the original 3x3 window.
// Give additional instances their own slots, keyed by their world transform.
// Neighbouring sectors can retain the same object through native refcounts.
bool MapModels(Sector& sector) {
    if (sector.mapped) return true;
    if (sector.blockedKeys && liveKeys >= sector.blockedKeys - 1) return false;
    const auto resource = Native<0x089F72CC, uintptr_t(*)(uintptr_t, unsigned)>()(
        Address<0x08C109E0>(), at<unsigned>(sector.address() + 8));
    if (!Guest(resource, 12)) return false;
    const auto block = at<uintptr_t>(resource);
    if (!Guest(block, 104) || at<uint16_t>(block + 8) != 5) return false;
    Native<0x089F18A4, int(*)(uintptr_t)>()(block);
    if (!Native<0x08AE674C, int(*)(uintptr_t)>()(block + 24)) return false;
    const auto data = at<uintptr_t>(block + 16);
    if (!Guest(data, 60)) return false;
    const unsigned quadrant = sector.native[12];
    const auto header = data + 60 + (quadrant ? at<unsigned>(data + 4 * quadrant - 4) : 0);
    if (!Guest(header, 12)) return false;
    const unsigned count = at<uint16_t>(header), boxes = at<unsigned>(header + 4);
    const auto records = header + 12 + 16 * boxes;
    if (count > nativeSlots || boxes > nativeSlots || !Guest(header + 12, boxes * 16 + count * 12)) return false;
    unsigned boxModels = 0;
    for (unsigned i = 0; i < boxes; ++i) boxModels += at<uint16_t>(header + 12 + 16 * i + 12);
    if (boxModels != count) return false;
    std::fill(std::begin(sector.models), std::end(sector.models), uint16_t(0xFFFF));
    std::fill(std::begin(sector.visibility), std::end(sector.visibility), uint16_t(0));
    sector.boxCount = boxes;
    sector.mapped = true; // Release also unwinds a partially built mapping.
    for (unsigned i = 0; i < count; ++i) {
        const auto record = records + 12 * i;
        const unsigned encoded = at<uint16_t>(record), id = encoded & 0x7FF;
        ModelKey key{
            (int(sector.x()) * 60 - 3510) * 4096 + 32 * at<int16_t>(record + 6),
            (int(sector.y()) * 60 - 2490) * 4096 + 32 * at<int16_t>(record + 8),
            32 * at<int16_t>(record + 10), at<uint16_t>(record + 2),
            at<uint16_t>(record + 4), uint16_t(encoded & 0xF800), 0
        };
        if (sector.models[id] != 0xFFFF) {
            if (!Equal(keys[sector.models[id] - nativeSlots], key)) {
                DropMapping(sector);
                sector.blockedKeys = liveKeys + 1;
                return false;
            }
            continue;
        }
        const auto slot = FindModel(key);
        if (slot == modelSlots) {
            DropMapping(sector);
            sector.blockedKeys = liveKeys + 1;
            return false;
        }
        ++keys[slot - nativeSlots].users;
        sector.models[id] = uint16_t(slot);
    }
    return true;
}
unsigned Remap(unsigned id) {
    if (currentSector && currentSector->mapped && id < nativeSlots)
        if (currentSector->models[id] != 0xFFFF) return currentSector->models[id];
    return id;
}
uintptr_t GetModel(uintptr_t object, unsigned id) { return modelLookup.fun(object, Remap(id)); }
int ReleaseModel(uintptr_t object, unsigned id, unsigned visible) {
    return modelRelease.fun(object, Remap(id), visible);
}
bool LoadingSlot() {
    for (const auto used : loadingUsed) if (!used) return true;
    return false;
}
bool NativeOwns(unsigned x, unsigned y) {
    for (unsigned i = 0; i < 9; ++i) {
        const auto p = world + 464 + 1892 * i;
        if (at<uint16_t>(p + 16) != 0xFFFF && at<uint8_t>(p + 14) == x && at<uint8_t>(p + 15) == y)
            return true;
    }
    return false;
}
bool ExtraOwns(unsigned x, unsigned y) {
    for (const auto& sector : sectors)
        if (sector.assigned && sector.x() == x && sector.y() == y) return true;
    return false;
}
bool NativeReady(const Sector& sector) {
    const auto p = world + 464 + 1892 * (3 * (sector.x() % 3) + sector.y() % 3);
    if (at<uint8_t>(p + 13) != 1 || at<uint8_t>(p + 14) != sector.x() ||
        at<uint8_t>(p + 15) != sector.y()) return false;
    // A request or a decompressed sector is insufficient: the native model
    // instances must actually hold their resources before removing extras.
    for (unsigned id = 0; id < nativeSlots; ++id) {
        const auto slot = sector.models[id];
        if (slot == 0xFFFF) continue;
        const auto model = modelTable[id];
        const auto& key = keys[slot - nativeSlots];
        if (!Guest(model, 256) || !at<uint8_t>(model + 192) ||
            at<uint16_t>(model + 32) != key.resource ||
            at<float>(model + 76) != key.x / 4096.0f ||
            at<float>(model + 92) != key.y / 4096.0f ||
            at<float>(model + 108) != key.z / 4096.0f) return false;
    }
    return true;
}
struct View {
    float x, y, forwardX, forwardY, tangent;
    explicit View(uintptr_t camera) {
        x = at<int>(camera + 256) / 4096.0f;
        y = at<int>(camera + 260) / 4096.0f;
        forwardX = -at<int>(camera + 244) / 4096.0f;
        forwardY = -at<int>(camera + 248) / 4096.0f;
        const float length = std::hypot(forwardX, forwardY);
        if (length > 0.01f) { forwardX /= length; forwardY /= length; }
        tangent = std::clamp(float(at<int>(camera + 80)) / std::max(1, at<int>(camera + 84)) *
                             at<int>(camera + 88) / 4096.0f, 0.2f, 4.0f);
    }
    float Distance(unsigned sx, unsigned sy) const {
        const float dx = int(sx) * 60 - 3480 - x, dy = int(sy) * 60 - 2460 - y;
        return dx * dx + dy * dy;
    }
    bool Contains(unsigned sx, unsigned sy, float margin) const {
        const float dx = int(sx) * 60 - 3480 - x, dy = int(sy) * 60 - 2460 - y;
        const float ahead = dx * forwardX + dy * forwardY;
        const float side = std::abs(dx * forwardY - dy * forwardX);
        return Distance(sx, sy) <= (drawDistance + margin) * (drawDistance + margin) &&
               (Distance(sx, sy) < 90 * 90 || (ahead >= -margin && side <= ahead * tangent + margin));
    }
};
void UpdateSectors(uintptr_t camera) {
    const int cx = ((at<int>(camera + 256) + 3510 * 4096) / 4096) / 60;
    const int cy = ((at<int>(camera + 260) + 2490 * 4096) / 4096) / 60;
    const int radius = std::min(6, (drawDistance + 59) / 60);
    const View view(camera);
    for (auto& sector : sectors) {
        if (sector.assigned && (std::abs(int(sector.x()) - cx) > radius ||
            std::abs(int(sector.y()) - cy) > radius || !view.Contains(sector.x(), sector.y(), 90) ||
            (sector.mapped && NativeReady(sector)))) Release(sector);
    }
    // Finish existing reads before adding more. Native ProcessWorld handles
    // its nine sectors first; extra scenery cannot starve the nearby grid.
    // Poll one unfinished sector per frame. Completed sectors never re-enter
    // the native resource/texture loading loop.
    for (unsigned n = 0; n < maxSectors; ++n) {
        auto& sector = sectors[pollCursor++ % maxSectors];
        if (!sector.assigned || sector.ready || (sector.blockedKeys && liveKeys >= sector.blockedKeys - 1)) continue;
        if (MapModels(sector)) {
            Context context(sector);
            sector.ready = Native<0x089F3B90, int(*)(uintptr_t)>()(sector.address()) != 0;
            if (sector.ready) Unlink(sector);
        }
        break;
    }
    for (unsigned i = 0; i < maxSectors; ++i) {
        auto& sector = sectors[i];
        if (!sector.assigned || !sector.mapped || sector.native[13] != 1) continue;
        // Distant visibility work is spread over four frames.
        if ((i & 3u) != (frame & 3u)) continue;
        Context context(sector);
        int offset[3]{(int(sector.x()) * 60 - 3510) * 4096 - at<int>(camera + 256),
                      (int(sector.y()) * 60 - 2490) * 4096 - at<int>(camera + 260), -at<int>(camera + 264)};
        Native<0x089F21D4, void(*)(uintptr_t, uintptr_t, const int*)>()(sector.address(), camera, offset);
    }
    // Reserve work for nearby and forward scenery rather than filling the
    // renderer with sectors behind the camera. A wider retention margin
    // avoids repeatedly unloading and reloading at the view edges.
    if (++frame % 4) return;
    unsigned pending = 0;
    for (const auto& sector : sectors) if (sector.assigned && !sector.ready && !sector.blockedKeys) ++pending;
    if (pending >= 4) return;
    int bestX = -1, bestY = -1;
    float bestDistance = 1.0e30f;
    for (int dx = -radius; dx <= radius; ++dx) for (int dy = -radius; dy <= radius; ++dy) {
            const int x = cx + dx, y = cy + dy;
            if (x < 0 || x >= 118 || y < 0 || y >= 84 || NativeOwns(x, y) || ExtraOwns(x, y)) continue;
            if (!view.Contains(x, y, 60) || view.Distance(x, y) >= bestDistance) continue;
            if (Native<0x089F3B44, unsigned(*)(uintptr_t, unsigned, unsigned)>()(world, x, y) == 0xFFFF) continue;
            bestX = x; bestY = y; bestDistance = view.Distance(x, y);
    }
    if (bestX >= 0) {
            const unsigned x = unsigned(bestX), y = unsigned(bestY);
            if (!LoadingSlot() || at<unsigned>(Address<0x08C1CDD0>() + 10260) >= rendererLimit) return;
            const auto id = Native<0x089F3B44, unsigned(*)(uintptr_t, unsigned, unsigned)>()(world, x, y);
            if (id == 0xFFFF) return;
            for (auto& sector : sectors) if (!sector.assigned) {
                std::memset(sector.native, 0, sizeof(sector.native));
                at<unsigned>(sector.address() + 8) = 0xFFFF;
                sector.assigned = true;
                sector.ready = false;
                sector.blockedKeys = 0;
                Context context(sector);
                Native<0x089F1D20, int(*)(uintptr_t, char, char, int16_t, uintptr_t, int)>()(
                    sector.address(), char(x), char(y), int16_t(id), 0, 0);
                // Do not put extra sectors on the native loading queue:
                // their per-sector ID mapping must be active during loading.
                return;
            }
            return;
    }
}
void ProcessWorld(uintptr_t object) {
    if (world && world != object) ReleaseAll();
    if (!ThirdPersonCamera()) ReleaseAll();
    world = object;
    processWorld.fun(object);
    const auto player = Player();
    const auto camera = player ? at<uintptr_t>(player + 3624) : 0;
    if (ThirdPersonCamera() && Guest(camera, 324) && at<uintptr_t>(object + 17492)) {
#ifndef NDEBUG
        if (diagnosticNativeGrid) return;
#endif
        UpdateSectors(camera);
    }
}
int UnloadWorld(uintptr_t object) { ReleaseAll(); return unloadWorld.fun(object); }
int ResetWorld(uintptr_t object) { ReleaseAll(); return resetWorld.fun(object); }
int PrepareWorld(uintptr_t object) { ReleaseAll(); return prepareWorld.fun(object); }
void InitializeCache(uintptr_t, unsigned) {
    Native<0x0893850C, void(*)(uintptr_t, void*, unsigned, unsigned)>()(
        Address<0x08C11110>(), resourceCache, sizeof(resourceCache), 0);
    Native<0x08938EA0, void(*)(uintptr_t, uintptr_t)>()(Address<0x08C11110>(), Address<0x089F6694>());
}
void InitializeGeometry(uintptr_t heap, void*, unsigned, unsigned flags) {
    Native<0x0893850C, void(*)(uintptr_t, void*, unsigned, unsigned)>()(
        heap, geometryCache, sizeof(geometryCache), flags);
}
int InitializeBlocks(uintptr_t pool, const char* name, unsigned, unsigned size, unsigned) {
    return Native<0x089D480C, InitPool>()(pool, name, blockPool, size, 192);
}
int InitializeProxies(uintptr_t pool, const char* name, unsigned, unsigned size, unsigned) {
    return Native<0x089D480C, InitPool>()(pool, name, proxies, size, 4096);
}
void* AllocateModels(void*, unsigned, unsigned, uintptr_t) { return modelPool; }
int InitializeModels(uintptr_t pool, const char* name, void*, unsigned size, unsigned) {
    return Native<0x089D480C, InitPool>()(pool, name, modelPool, size, modelSlots);
}
void* AllocateModelTable(unsigned) { std::memset(modelTable, 0, sizeof(modelTable)); return modelTable; }
uintptr_t LoadingBuffer(uintptr_t object) {
    // Preserve the four native ownership flags: ProcessWorld relies on them
    // when deciding whether it is safe to recenter its 3x3 grid.
    if (!currentSector) {
        for (unsigned i = 0; i < 4; ++i) {
            if (!at<uint8_t>(object + 16 + i)) {
                at<uint8_t>(object + 16 + i) = 1;
                return at<uintptr_t>(object + 4 * i);
            }
        }
        return 0;
    }
    for (unsigned i = 0; i < loadingBuffers; ++i) if (!loadingUsed[i]) {
        loadingUsed[i] = true;
        return reinterpret_cast<uintptr_t>(loadingData[i]);
    }
    return 0;
}
void ReleaseBuffer(uintptr_t object, uintptr_t buffer) {
    const auto first = reinterpret_cast<uintptr_t>(loadingData);
    if (buffer >= first && buffer < first + sizeof(loadingData) &&
        (buffer - first) % loadingBufferBytes == 0) {
        loadingUsed[(buffer - first) / loadingBufferBytes] = false;
    } else releaseBuffer.fun(object, buffer);
}
}
void UpdateDrawDistance(uintptr_t camera) {
    if (!streaming) return;
    // The stock camera's far plane is 150 world units. Its near plane stays
    // intact. Switching back restores the native value on the same camera.
    const int far = (ThirdPersonCamera() ? drawDistance : 150) * 4096;
    if (at<int>(camera + 96) != far) {
        at<int>(camera + 96) = far;
        at<uint8_t>(camera + 106) = 1;
    }
}
void InstallSky();
void InstallStreaming() {
    if (!inireader.ReadInteger("MAIN", "Enable3rdPersonCamera", 1)) return;
    drawDistance = std::clamp(inireader.ReadInteger("MAIN", "ThirdPersonDrawDistance", 300), 180, 360);
    streaming = true;
#ifndef NDEBUG
    diagnosticNativeGrid = inireader.ReadInteger("DIAGNOSTICS", "NativeGridOnly", 0) != 0;
#endif
    std::fill(std::begin(hashHeads), std::end(hashHeads), uint16_t(0xFFFF));
    injector::MakeCALL(Address<0x088D0B6C>(), InitializeCache);
    injector::MakeCALL(Address<0x088D0FAC>(), InitializeGeometry);
    injector::MakeCALL(Address<0x089F468C>(), InitializeBlocks);
    injector::MakeCALL(Address<0x088D0814>(), InitializeProxies);
    injector::MakeCALL(Address<0x089F2EEC>(), AllocateModels);
    injector::MakeCALL(Address<0x089F2F08>(), InitializeModels);
    injector::MakeCALL(Address<0x089F2F24>(), AllocateModelTable);
    injector::MakeCALL(Address<0x089F4064>(), PollResources);
    injector::MakeCALL(Address<0x089F4070>(), PollTextures);
    injector::MakeCALL(Address<0x08948AAC>(), ClipWaterGeometry);
    static SafetyMipsInline waterAdd;
    waterAdd = safetymips::create_inline(Address<0x08A5E0B4>(), AddWaterModel);
    addWaterModel.fun = waterAdd.original<void(*)(uintptr_t, uintptr_t)>();
    static SafetyMipsInline displayInitialize, displayBegin;
    displayInitialize = safetymips::create_inline(Address<0x0890D17C>(), InitializeDisplayLists);
    displayBegin = safetymips::create_inline(Address<0x0890D1A0>(), BeginFrame);
    beginFrame.fun = displayBegin.original<int(*)()>();
    static SafetyMipsInline variantRegister, variantRemove, variantReset, variantSelect, variantProcess;
    variantRegister = safetymips::create_inline(Address<0x088696F8>(), RegisterVariant);
    variantRemove = safetymips::create_inline(Address<0x08869888>(), RemoveVariant);
    variantReset = safetymips::create_inline(Address<0x088694EC>(), ResetVariants);
    variantSelect = safetymips::create_inline(Address<0x088698C8>(), SelectVariant);
    variantProcess = safetymips::create_inline(Address<0x08869514>(), ProcessVariants);
    for (const auto site : {0x088D200Cu, 0x088D2148u, 0x08950568u, 0x08954418u,
                           0x08956664u, 0x0895FC00u, 0x0896270Cu, 0x089893B4u})
        processWorld.fun = injector::MakeCALL(nativeProfile.get(site), ProcessWorld).get();
    // These three entry points cover area unloads, menu resets and cache resets.
    static SafetyMipsInline unloadHook, resetHook, prepareHook;
    unloadHook = safetymips::create_inline(Address<0x089F2D80>(), UnloadWorld);
    unloadWorld.fun = unloadHook.original<int(*)(uintptr_t)>();
    resetHook = safetymips::create_inline(Address<0x089F2E90>(), ResetWorld);
    resetWorld.fun = resetHook.original<int(*)(uintptr_t)>();
    prepareHook = safetymips::create_inline(Address<0x089F3070>(), PrepareWorld);
    prepareWorld.fun = prepareHook.original<int(*)(uintptr_t)>();
    lookupHook = safetymips::create_inline(Address<0x089F357C>(), GetModel);
    modelLookup.fun = lookupHook.original<uintptr_t(*)(uintptr_t, unsigned)>();
    releaseHook = safetymips::create_inline(Address<0x089F35F0>(), ReleaseModel);
    modelRelease.fun = releaseHook.original<int(*)(uintptr_t, unsigned, unsigned)>();
    static SafetyMipsInline bufferHook, bufferReleaseHook;
    bufferHook = safetymips::create_inline(Address<0x089F30FC>(), LoadingBuffer);
    bufferReleaseHook = safetymips::create_inline(Address<0x089F314C>(), ReleaseBuffer);
    releaseBuffer.fun = bufferReleaseHook.original<void(*)(uintptr_t, uintptr_t)>();
    static SafetyMipsInline linkHook;
    safetymips::Options caller; caller.preserve_game_callees = false;
    linkHook = safetymips::create_inline(Address<0x08AE51B8>(), LinkModel, caller);
    linkModel.fun = linkHook.original<void(*)(uintptr_t)>();
    InstallSky();
}
}

// ===== SNAPSHOT: Sky.cpp =====
#include "Game.hpp"
#include <algorithm>
#include <cmath>

namespace ctw {
namespace {
injector::hook_back<void(uintptr_t, uint8_t, uint8_t, uint8_t, uint32_t, uint32_t)> clearWorld;
struct Vertex { uint32_t colour; int16_t x, y; uint32_t z; };
static_assert(sizeof(Vertex) == 12);
uint32_t Blend(uint32_t a, uint32_t b, float t) {
    uint32_t colour = 0xFF000000;
    for (unsigned shift = 0; shift < 24; shift += 8) {
        const auto value = unsigned(float((a >> shift) & 255) * (1 - t) + float((b >> shift) & 255) * t);
        colour |= std::min(value, 255u) << shift;
    }
    return colour;
}
void ClearWorld(uintptr_t context, uint8_t colour, uint8_t stencil, uint8_t depth,
                uint32_t fog, uint32_t z) {
    clearWorld.fun(context, colour, stencil, depth, fog, z);
    if (!ThirdPersonCamera() || !colour) return;
    const auto player = Player();
    const auto camera = player ? at<uintptr_t>(player + 3624) : 0;
    if (!Guest(camera, 324)) return;
    const float forwardZ = -float(at<int>(camera + 252)) / 4096.0f;
    const float horizontal = std::sqrt(std::max(0.001f, 1 - forwardZ * forwardZ));
    // Project the horizon using the same vertical field of view as the camera.
    const float focal = 136.0f * float(at<int>(camera + 84)) / std::max(1, at<int>(camera + 80));
    const int horizon = std::clamp(int(136 + focal * forwardZ / horizontal), 0, 272);
    if (!horizon) return;
    const unsigned brightness = ((fog & 255) + ((fog >> 8) & 255) + ((fog >> 16) & 255)) / 3;
    const auto top = Blend(0xFF201408, 0xFFD09058, float(brightness) / 255.0f);
    constexpr unsigned bands = 32, strips = 8, vertexCount = 2 * bands * strips;
    const auto end = at<uintptr_t>(context + 12);
    const auto start = (end - sizeof(Vertex) * vertexCount) & ~uintptr_t(15);
    if (!Guest(start, sizeof(Vertex) * vertexCount) || start <= at<uintptr_t>(context) + 64) return;
    at<uintptr_t>(context + 12) = start;
    auto* vertices = reinterpret_cast<Vertex*>(start);
    unsigned n = 0;
    for (unsigned band = 0; band < bands; ++band) {
        const int topY = horizon * band / bands, bottomY = horizon * (band + 1) / bands;
        const float t = float(band + 1) / bands;
        const auto c = Blend(top, fog, t * t);
        for (unsigned strip = 0; strip < strips; ++strip) {
            const int left = int(strip) * 64, right = std::min(left + 64, 480);
            vertices[n++] = {c, int16_t(left), int16_t(topY), z};
            vertices[n++] = {c, int16_t(right), int16_t(bottomY), z};
        }
    }
    // GE clear mode changes only RGB here, preserving depth and stencil.
    // The native primitive writer maintains its cached vertex address state.
    auto emit = [context](uint32_t command) {
        at<uint32_t>(at<uintptr_t>(context)) = command;
        at<uintptr_t>(context) += 4;
    };
    emit(0xD3000101);
    reinterpret_cast<void(*)(uintptr_t, unsigned, unsigned, unsigned, uintptr_t, uintptr_t)>(
        Address<0x089100C0>())(context, 6, 0x80011C, vertexCount, 0, start);
    emit(0xD3000000);
}
}
void InstallSky() {
    if (inireader.ReadInteger("MAIN", "ThirdPersonSky", 1))
        clearWorld.fun = injector::MakeCALL(Address<0x089EFB80>(), ClearWorld).get();
}
}

