// ===== SNAPSHOT: shipped INI =====
[MAIN]
; Viewport aspect ratio: auto reads PPSSPP's stretch setting, or use e.g. 21:9 or 32:9.
ForceAspectRatio = auto
; R-button/Cross, L-button/Square swap, in vehicle, swap buttons with triggers in the emulator settings to drive with triggers
SwapDrivingControls = 1
; R-button/Circle swap, on foot, requires SwapDrivingControls to be enabled, to shoot with RB
SwapRBCircle = 1
; Press DPAD-RIGHT to switch between cameras. Use Right Stick to adjust position and angle. Original cinematic camera will be disabled
Enable3rdPersonCamera = 1
; Far plane in world units for the vehicle camera (180-360). The original is 150.
; Scenery uses a 32 MB resource cache and 48 loading buffers in PPSSPP's extended RAM.
ThirdPersonDrawDistance = 300
; Draw a sky gradient above the horizon, using the current fog colour.
ThirdPersonSky = 1
; Enables radio in emergency vehicles
RadioInAllVehicles = 1
; Fast PDA Transitions and intro
UnthrottleEmuDuringLoading = 1
; Present Xin missions as available to the replay board without changing saved progress. Experimental, disabled by default.
UnlockXinMissionsInReplayBoard = 0
; Scale the complete gameplay HUD, including radar, around its screen-edge anchors (0.5 to 1.0). PDA apps retain their native proportions and size.
HUDScale = 1.0
