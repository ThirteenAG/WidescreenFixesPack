{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "audio",
      "title": "@page.audio",
      "section": "audio"
    },
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.ForceAspectRatio",
      "type": "string",
      "default": "auto",
      "label": "@ForceAspectRatio",
      "description": "@ForceAspectRatio.description",
      "page": "display",
      "visibility": "editor",
      "apply": "restart",
      "maxLength": 14,
      "suggestions": [
        "auto",
        "4:3",
        "16:9",
        "21:9",
        "32:9"
      ]
    },
    {
      "id": "MAIN.ModernControls",
      "type": "bool",
      "default": 1,
      "label": "@ModernControls",
      "description": "@ModernControls.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.Enable3rdPersonCamera",
      "type": "bool",
      "default": 1,
      "label": "@Enable3rdPersonCamera",
      "description": "@Enable3rdPersonCamera.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.RadioInAllVehicles",
      "type": "bool",
      "default": 1,
      "label": "@RadioInAllVehicles",
      "description": "@RadioInAllVehicles.description",
      "page": "audio",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@UnthrottleEmuDuringLoading",
      "description": "@UnthrottleEmuDuringLoading.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnlockXinMissionsInReplayBoard",
      "type": "bool",
      "default": 0,
      "label": "@UnlockXinMissionsInReplayBoard",
      "description": "@UnlockXinMissionsInReplayBoard.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "restart"
    },
    {
      "id": "MAIN.HudScale",
      "type": "float",
      "default": 1.0,
      "label": "@HudScale",
      "description": "@HudScale.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      },
      "min": 0.5,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
