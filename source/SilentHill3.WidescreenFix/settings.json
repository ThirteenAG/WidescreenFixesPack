    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@hudconstraint",
      "description": "@hudconstraint.description",
      "page": "display",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "presets": {
        "vanilla": "Auto",
        "recommended": "Auto",
        "enhanced": "Auto"
      }
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "editor",
      "apply": "live"
    }
