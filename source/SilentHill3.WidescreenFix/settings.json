      "max": 2.0,
      "step": 0.05,
      "label": "@fovfactor",
      "description": "@fovfactor.description",
      "page": "display",
      "apply": "live",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@displaymode",
      "description": "@displaymode.description",
      "page": "display",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@displaymode.fullscreen"
        },
        {
          "value": 1,
          "label": "@displaymode.windowed"
        },
        {
          "value": 2,
          "label": "@displaymode.borderless"
        }
      ]
