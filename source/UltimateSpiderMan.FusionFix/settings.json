{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Ultimate Spider-Man",
        "exe": [
          "USM.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "controls"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@MAIN_SkipIntro",
      "description": "@MAIN_SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@MAIN_HudAspectRatioConstraint",
      "description": "@MAIN_HudAspectRatioConstraint.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "label": "@MAIN_FPSLimit",
      "description": "@MAIN_FPSLimit.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "min": -1,
      "max": 1000
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@MAIN_PauseOnFocusLoss",
      "description": "@MAIN_PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.WindowMode",
      "type": "int",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@windowmode.fullscreen"
        },
        {
          "value": 1,
          "label": "@windowmode.windowed"
        },
        {
          "value": 2,
          "label": "@windowmode.borderless"
        }
      ]
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@MAIN_FOVFactor",
      "description": "@MAIN_FOVFactor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "GRAPHICS.DrawDistance",
      "type": "float",
      "default": 1.0,
      "label": "@MAIN_DrawDistanceScale",
      "description": "@MAIN_DrawDistanceScale.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "restart",
      "min": 1,
      "max": 10
    },
    {
      "id": "GRAPHICS.AntiAliasing",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1,
      "label": "@GRAPHICS_SMAA",
      "description": "@GRAPHICS_SMAA.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "GRAPHICS.ConsoleGamma",
      "type": "bool",
      "default": false,
      "label": "@GRAPHICS_ConsoleGamma",
      "description": "@GRAPHICS_ConsoleGamma.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": false,
        "recommended": false,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@MAIN_FMVWidescreenMode",
      "description": "@MAIN_FMVWidescreenMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@fmv.original"
        },
        {
          "value": 1,
          "label": "@fmv.fill"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN_TextLanguage",
      "description": "@MAIN_TextLanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "live",
      "choices": [
        {
          "value": "auto",
          "label": "@language.auto"
        },
        {
          "value": "en",
          "label": "@language.en"
        },
        {
          "value": "de",
          "label": "@language.de"
        },
        {
          "value": "es",
          "label": "@language.es"
        },
        {
          "value": "fr",
          "label": "@language.fr"
        },
        {
          "value": "it",
          "label": "@language.it"
        }
      ]
    },
    {
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "id": "MAIN.CameraAutoCenter",
      "type": "int",
      "default": 1,
      "label": "@MAIN_CameraAutoCenter",
      "description": "@MAIN_CameraAutoCenter.description",
      "choices": [
        {
          "value": 0,
          "label": "@camera.autocenter.original"
        },
        {
          "value": 1,
          "label": "@camera.autocenter.delayed"
        },
        {
          "value": 2,
          "label": "@camera.autocenter.off"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "id": "MAIN.CameraRecenterDelay",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 5.0,
      "step": 0.5,
      "label": "@MAIN_CameraRecenterDelay",
      "description": "@MAIN_CameraRecenterDelay.description"
    },
    {
      "id": "MAIN.MouseSensitivity",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.1,
      "label": "@MAIN_MouseSensitivity",
      "description": "@MAIN_MouseSensitivity.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.InvertMouseY",
      "type": "bool",
      "default": false,
      "label": "@MAIN_InvertMouseY",
      "description": "@MAIN_InvertMouseY.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.GamepadCameraSpeed",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.1,
      "label": "@MAIN_GamepadCameraSpeed",
      "description": "@MAIN_GamepadCameraSpeed.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.Language",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN_Language",
      "description": "@MAIN_Language.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        {
          "value": "auto",
          "label": "@language.auto"
        },
        {
          "value": "en",
          "label": "@language.en"
        },
        {
          "value": "fr",
          "label": "@language.fr"
        },
        {
          "value": "de",
          "label": "@language.de"
        },
        {
          "value": "es",
          "label": "@language.es"
        },
        {
          "value": "it",
          "label": "@language.it"
        }
      ]
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@MAIN_CheckForUpdates",
      "description": "@MAIN_CheckForUpdates.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
