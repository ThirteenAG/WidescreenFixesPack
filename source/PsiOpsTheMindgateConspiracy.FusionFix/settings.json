{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Psi-Ops: The Mindgate Conspiracy",
        "exe": [
          "PsiOps.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "game",
      "title": "@page.game",
      "section": "gameplay"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    },
    {
      "id": "framerate",
      "title": "@page.framerate",
      "section": "graphics"
    }
  ],
  "settings": [
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": 0,
      "max": 3,
      "step": 1,
      "choices": [
        {
          "value": 0,
          "label": "@borders.off"
        },
        {
          "value": 1,
          "label": "@borders.letter"
        },
        {
          "value": 2,
          "label": "@borders.pillar"
        },
        {
          "value": 3,
          "label": "@borders.both"
        }
      ],
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.AnimatedCutsceneBorders",
      "type": "bool",
      "default": true,
      "label": "@AnimatedCutsceneBorders",
      "description": "@AnimatedCutsceneBorders.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "game",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "choices": [
        {
          "value": 0,
          "label": "@windowmode.fullscreen"
        },
        {
          "value": 1,
          "label": "@windowmode.windowed"
        },
        {
          "value": 2,
          "label": "@windowmode.borderless"
        }
      ],
      "min": 0,
      "max": 2
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "recommended": true,
        "enhanced": true,
        "vanilla": false
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@textlanguage",
      "description": "@textlanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "live"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@checkupdates",
      "description": "@checkupdates.description",
      "page": "game",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "min": 30,
      "max": 1000,
      "step": 1,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "framerate",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 60,
        "enhanced": 60
      },
      "unit": "fps",
      "special": [
        {
          "value": 0,
          "label": "@fps.unlimited"
        },
        {
          "value": -1,
          "label": "@fps.monitor"
        }
      ],
      "suggestions": [
        {
          "value": 30
        },
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 240
        }
      ]
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "game",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    }
  ]
}
