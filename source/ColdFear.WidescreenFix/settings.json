{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Cold Fear",
        "exe": [
          "ColdFear_retail.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "widescreen",
      "title": "@page.widescreen",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility",
      "order": 1000
    }
  ],
  "settings": [
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2,
      "unit": "x",
      "label": "@fovfactor",
      "description": "@fovfactor.description",
      "page": "widescreen",
      "group": "@group.camera",
      "control": [
        "slider"
      ],
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.HudWidescreenMode",
      "type": "bool",
      "default": 1,
      "label": "@hudedges",
      "description": "@hudedges.description",
      "page": "widescreen",
      "group": "@group.hud",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@hudaspect.auto"
        }
      ],
      "suggestions": [
        {
          "value": "16:9"
        },
        {
          "value": "16:10"
        },
        {
          "value": "21:9"
        },
        {
          "value": "4:3"
        }
      ],
      "label": "@hudaspect",
      "description": "@hudaspect.description",
      "page": "widescreen",
      "group": "@group.hud",
      "control": [
        "cycler",
        "dropdown"
      ],
      "enabledIf": {
        "setting": "MAIN.HudWidescreenMode",
        "equals": 1
      },
      "presets": {
        "vanilla": "Auto",
        "recommended": "Auto",
        "enhanced": "Auto"
      }
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@off"
        },
        {
          "value": 1,
          "label": "@cutsceneborders.letterbox"
        },
        {
          "value": 2,
          "label": "@cutsceneborders.pillarbox"
        },
        {
          "value": 3,
          "label": "@cutsceneborders.both"
        }
      ],
      "label": "@cutsceneborders",
      "description": "@cutsceneborders.description",
      "page": "widescreen",
      "group": "@group.cutscenes",
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      },
      "control": [
        "segmented",
        "cycler"
      ]
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@fmv.original"
        },
        {
          "value": 1,
          "label": "@fmv.fill"
        },
        {
          "value": 2,
          "label": "@fmv.stretch"
        }
      ],
      "label": "@fmv",
      "description": "@fmv.description",
      "page": "widescreen",
      "group": "@group.cutscenes",
      "control": [
        "segmented",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "GRAPHICS.AntiAliasing",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@off"
        },
        {
          "value": 1,
          "label": "TAA"
        },
        {
          "value": 2,
          "label": "DLAA"
        },
        {
          "value": 3,
          "label": "FSR"
        }
      ],
      "label": "@antialiasing",
      "description": "@antialiasing.description",
      "page": "graphics",
      "group": "@group.antialiasing",
      "control": [
        "cycler",
        "dropdown"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 0,
        "enhanced": 1
      }
    },
    {
      "id": "GRAPHICS.Sharpness",
      "type": "float",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "@aasharpness",
      "description": "@aasharpness.description",
      "page": "graphics",
      "group": "@group.antialiasing",
      "control": [
        "slider"
      ],
      "enabledIf": {
        "setting": "GRAPHICS.AntiAliasing",
        "notEquals": 0
      },
      "presets": {
        "vanilla": 25,
        "recommended": 25,
        "enhanced": 25
      }
    },
    {
      "id": "MAIN.GraphicsAPI",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "Direct3D 9"
        },
        {
          "value": 1,
          "label": "Vulkan (DXVK)"
        },
        {
          "value": 2,
          "label": "D3D9on12"
        }
      ],
      "label": "@graphicsapi",
      "description": "@graphicsapi.description",
      "page": "graphics",
      "group": "@group.antialiasing",
      "control": [
        "cycler",
        "dropdown"
      ],
      "apply": "restart"
    },
    {
      "id": "GRAPHICS.D3D9on12",
      "type": "bool",
      "default": 0,
      "label": "D3D9on12",
      "description": "@d3d9on12.description",
      "page": "graphics",
      "visibility": "file",
      "apply": "restart"
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@windowed.fullscreen"
        },
        {
          "value": 1,
          "label": "@windowed.windowed"
        },
        {
          "value": 2,
          "label": "@windowed.borderless"
        }
      ],
      "label": "@windowed",
      "description": "@windowed.description",
      "page": "display",
      "group": "@group.window",
      "control": [
        "cycler",
        "dropdown"
      ],
      "apply": "restart"
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32767,
      "special": [
        {
          "value": 0,
          "label": "@res.game"
        }
      ],
      "label": "@resx",
      "description": "@resx.description",
      "page": "display",
      "group": "@group.resolution",
      "apply": "restart",
      "visibility": "editor"
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32767,
      "special": [
        {
          "value": 0,
          "label": "@res.game"
        }
      ],
      "label": "@resy",
      "description": "@resy.description",
      "page": "display",
      "group": "@group.resolution",
      "apply": "restart",
      "visibility": "editor"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "widescreen",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@confinecursor",
      "description": "@confinecursor.description",
      "page": "display",
      "visibility": "editor",
      "apply": "live"
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "menu",
      "choices": [
        {
          "value": "auto",
          "label": "Automatic"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ]
    }
  ]
}
