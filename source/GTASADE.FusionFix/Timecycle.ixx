                hook::pattern("41 88 84 0E E0 B4 23 05 F3 0F 2C 45 18 41 88 84 0E 20 B4 23 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E 20 B4 23 05 F3 0F 2C 45 1C 41 88 84 0E 60 B6 23 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E 60 B6 23 05 F3 0F 2C 45 20 41 88 84 0E A0 B5 23 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E A0 B5 23 05 F3 0F 2C 45 24 41 88 84 0E E0 B1 23 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E E0 B1 23 05 F3 0F 2C 45 28 41 88 84 0E 20 B1 23 05 0F B6 45").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E 20 B1 23 05 0F B6 45 2C 41 88 84 0E 60 B3 23 05 0F B6 45 30").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E 60 B3 23 05 0F B6 45 30 41 88 84 0E A0 B2 23 05 F3 0F 2C C0").get_first<uint8_t>(4),
                hook::pattern("41 88 84 0E A0 B2 23 05 F3 0F 2C C0 41 88 84 0E 60 B0 23 05 49 81 FF B8").get_first<uint8_t>(4),
            };
            if (!initialise || std::ranges::any_of(addresses, [](const auto address) { return !address; }))
                return;
            const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
            const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
            constexpr std::array<Storage, 39> storage{Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte};
            for (size_t column = 0; column < tables.size(); ++column)
            {
                // Indexed table operands contain an RVA relative to the native
                // loader's module-base register. Read it from the matched store;
                // no executable addresses or table RVAs are baked into the fix.
                const auto rva = injector::ReadMemory<uint32_t>(addresses[column], true);
                const size_t bytes = hours * weathers * (storage[column] == Storage::Byte ? 1 : 4);
                if (!rva || rva > nt->OptionalHeader.SizeOfImage - bytes)
                    return;
                tables[column] = {reinterpret_cast<void*>(base + rva), storage[column]};
            }
            initialiseHook = safetyhook::create_inline(initialise, Initialise);
            if (!initialiseHook)
                return;
            // CGame's remaining initialization can adjust individual colours.
            // Reapply after it finishes, also covering restarts and save loads.
            WFP::onGameInitEvent() += ApplyColours;
        };
    }
} TimecycleModuleInstance;
