                hook::pattern("42 88 84 29 60 1A 12 05 0F B6 45 E4 42 88 84 29 10 1B 12 05 F3 0F 10 45").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 10 1B 12 05 F3 0F 10 45 EC 49 83 C6 07 0F B6 45 E8 BA 00 00").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 C0 1B 12 05 F3 0F 59 C6 F3 0F 2C C0 F3 0F 10 45 F0 42 88 84").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 20 1D 12 05 0F B6 45 14 42 88 84 29 D0 1D 12 05 0F B6 45 18").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 D0 1D 12 05 0F B6 45 18 42 88 84 29 80 1E 12 05 0F B6 45 1C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 80 1E 12 05 0F B6 45 1C 42 88 84 29 F0 25 12 05 0F B6 45 20").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 F0 25 12 05 0F B6 45 20 42 88 84 29 A0 26 12 05 0F B6 45 24").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 A0 26 12 05 0F B6 45 24 42 88 84 29 50 27 12 05 0F B6 45 28").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 50 27 12 05 0F B6 45 28 42 88 84 29 00 28 12 05 0F B6 45 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 00 28 12 05 0F B6 45 2C 42 88 84 29 30 23 12 05 0F B6 45 30").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 30 23 12 05 0F B6 45 30 42 88 84 29 E0 23 12 05 F3 0F 2C 45").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 E0 23 12 05 F3 0F 2C 45 34 42 88 84 29 90 24 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 90 24 12 05 F3 0F 2C 45 38 42 88 84 29 40 25 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 40 25 12 05 F3 0F 2C 45 3C 42 88 84 29 60 29 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 60 29 12 05 F3 0F 2C 45 40 42 88 84 29 10 2A 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 10 2A 12 05 F3 0F 2C 45 44 42 88 84 29 C0 2A 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 C0 2A 12 05 F3 0F 2C 45 48 42 88 84 29 70 2B 12 05 F3 0F 2C").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 70 2B 12 05 F3 0F 2C 45 4C 42 88 84 29 B0 28 12 05 49 81 FE").get_first<uint8_t>(4),
                hook::pattern("42 88 84 29 B0 28 12 05 49 81 FE A8 00 00 00 0F 8C ? ? ? ? 66 FF C6").get_first<uint8_t>(4),
            };
            if (!initialise || std::ranges::any_of(addresses, [](const auto address) { return !address; }))
                return;
            const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
            const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
            constexpr std::array<Storage, 43> storage{Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte, Storage::Byte};
            for (size_t column = 0; column < tables.size(); ++column)
            {
                // Indexed table operands contain an RVA relative to the native
                // loader's module-base register. Read it from the matched store;
                // no executable addresses or table RVAs are baked into the fix.
                const auto rva = injector::ReadMemory<uint32_t>(addresses[column], true);
                const size_t bytes = hours * weathers * (storage[column] == Storage::Byte ? 1 : 4);
                if (!rva || rva > nt->OptionalHeader.SizeOfImage - bytes)
                    return;
                tables[column] = {reinterpret_cast<void*>(base + rva), storage[column]};
            }
            initialiseHook = safetyhook::create_inline(initialise, Initialise);
            if (!initialiseHook)
                return;
            // CGame's remaining initialization can adjust individual colours.
            // Reapply after it finishes, also covering restarts and save loads.
            WFP::onGameInitEvent() += ApplyColours;
        };
    }
} TimecycleModuleInstance;
