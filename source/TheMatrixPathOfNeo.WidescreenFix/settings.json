{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "The Matrix: Path of Neo",
        "exe": [
          "Matrix3.exe",
          "Matrix3-10.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    }
  ],
  "settings": [
    {
      "id": "MAIN.FixHud",
      "type": "bool",
      "default": 1,
      "label": "@FixHud",
      "description": "@FixHud.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 1,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    }
  ]
}
