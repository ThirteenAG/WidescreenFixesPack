{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Resident Evil HD",
        "exe": [
          "bhd.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.SkipPressStart",
      "type": "bool",
      "default": 1,
      "label": "@SkipPressStart",
      "description": "@SkipPressStart.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "min": 30,
      "max": 1000,
      "unit": "fps",
      "special": [
        {
          "value": 0,
          "label": "@FPSLimit.unlimited"
        },
        {
          "value": -1,
          "label": "@fps.monitor"
        }
      ],
      "suggestions": [
        {
          "value": 30
        },
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 165
        },
        {
          "value": 240
        }
      ],
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "apply": "live",
      "control": [
        "cycler",
        "dropdown"
      ],
      "presets": {
        "vanilla": 120,
        "recommended": 60,
        "enhanced": 60
      },
      "visibility": "menu"
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": 1,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.HideMouseCursorAfterMs",
      "type": "int",
      "default": 5000,
      "label": "@HideMouseCursorAfterMs",
      "description": "@HideMouseCursorAfterMs.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 5000,
        "enhanced": 5000
      },
      "special": [
        { "value": -1, "label": "@HideMouseCursorAfterMs.always" }
      ],
      "suggestions": [
        { "value": 0 },
        { "value": 1000 },
        { "value": 5000 },
        { "value": 10000 }
      ],
      "min": -1,
      "max": 600000
    },
    {
      "id": "MAIN.DoorSkip",
      "type": "bool",
      "default": 0,
      "label": "@DoorSkip",
      "description": "@DoorSkip.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 0,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.fullscreen"
        },
        {
          "value": 1,
          "label": "@WindowMode.windowed"
        },
        {
          "value": 2,
          "label": "@WindowMode.borderless"
        }
      ],
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": 1,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.LightSyncRGB",
      "type": "bool",
      "default": 1,
      "label": "@LightSyncRGB",
      "description": "@LightSyncRGB.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.DisableNoise",
      "type": "bool",
      "default": 0,
      "label": "@DisableNoise",
      "description": "@DisableNoise.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.DisableColorCorrection",
      "type": "bool",
      "default": 0,
      "label": "@DisableColorCorrection",
      "description": "@DisableColorCorrection.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.DisableFog",
      "type": "bool",
      "default": 0,
      "label": "@DisableFog",
      "description": "@DisableFog.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.ClassicKeyLinks",
      "type": "bool",
      "default": 0,
      "label": "@ClassicKeyLinks",
      "description": "@ClassicKeyLinks.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "page": "compatibility",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "visibility": "editor",
      "apply": "menu"
    },
    {
      "id": "MAIN.GamepadIcons",
      "type": "choice",
      "default": 0,
      "label": "@MAIN.GamepadIcons",
      "description": "@MAIN.GamepadIcons.description",
      "page": "display",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@menu.auto"
        },
        {
          "value": 1,
          "label": "Xbox"
        },
        {
          "value": 2,
          "label": "PlayStation"
        },
        {
          "value": 3,
          "label": "Nintendo"
        }
      ],
      "visibility": "menu"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@MAIN.CheckForUpdates",
      "description": "@MAIN.CheckForUpdates.description",
      "page": "compatibility",
      "apply": "live"
    }
  ]
}
