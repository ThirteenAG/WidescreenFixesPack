{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Far Cry",
        "exe": [
          "FarCry.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.WindowMode",
      "type": "int",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "choices": [
        {
          "value": 0,
          "label": "@Fullscreen"
        },
        {
          "value": 1,
          "label": "@Windowed"
        },
        {
          "value": 2,
          "label": "@Borderless"
        }
      ]
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": 1,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "int",
      "default": 1,
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "choices": [
        {
          "value": 0,
          "label": "@OriginalAspect"
        },
        {
          "value": 1,
          "label": "@Fill"
        },
        {
          "value": 2,
          "label": "@Stretch"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": "Auto",
        "recommended": "Auto",
        "enhanced": "Auto"
      },
      "choices": [
        {
          "value": "Auto",
          "label": "@menu.auto"
        },
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "21:9",
          "label": "21:9"
        }
      ]
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      },
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "GRAPHICS.AntiAliasing",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1,
      "label": "@SMAA",
      "description": "@SMAA.description",
      "page": "graphics",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 0,
        "enhanced": 0
      }
    },
    {
      "id": "GRAPHICS.ConsoleGamma",
      "type": "bool",
      "default": false,
      "label": "@ConsoleGamma",
      "description": "@ConsoleGamma.description",
      "page": "graphics",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": false,
        "recommended": false,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "maxLength": 32
    }
  ]
}
