{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "Fusion Fix",
    "priority": 100,
    "games": [
      {
        "name": "True Crime: New York City",
        "exe": [
          {
            "path": "True Crime New York City.exe",
            "label": "@exe.unprotected"
          },
          {
            "path": "True Crime® New York City.exe",
            "label": "@exe.retail"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "compatibility",
      "title": "@ui.compatibility",
      "section": "compatibility"
    },
    {
      "id": "game",
      "title": "@page.game",
      "section": "other"
    }
  ],
  "settings": [
    {
      "id": "MAIN.OverlayHotkey",
      "type": "int",
      "default": 121,
      "min": 1,
      "max": 255,
      "label": "@ui.settingsoverlayhotkey",
      "description": "@ui.settingsoverlayhotkey.description",
      "page": "controls",
      "visibility": "editor"
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@ui.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@ui.textlanguage",
      "description": "@ui.textlanguage.description",
      "page": "compatibility",
      "visibility": "editor"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@skipintro",
      "description": "@skipintro.description",
      "page": "game",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@pausefocus",
      "description": "@pausefocus.description",
      "page": "game",
      "apply": "live"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@updates",
      "description": "@updates.description",
      "page": "game",
      "apply": "live"
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@window.fullscreen"
        },
        {
          "value": 1,
          "label": "@window.windowed"
        },
        {
          "value": 2,
          "label": "@window.borderless"
        }
      ],
      "label": "@window",
      "description": "@window.description",
      "page": "display",
      "group": "@group.window",
      "control": [
        "dropdown",
        "cycler"
      ],
      "apply": "restart"
    },
    {
      "id": "MAIN.Language",
      "type": "choice",
      "default": -1,
      "choices": [
        {
          "value": -1,
          "label": "@language.game"
        },
        {
          "value": 0,
          "label": "@language.eng"
        },
        {
          "value": 1,
          "label": "@language.uk"
        },
        {
          "value": 2,
          "label": "@language.fre"
        },
        {
          "value": 3,
          "label": "@language.ger"
        },
        {
          "value": 4,
          "label": "@language.spa"
        },
        {
          "value": 5,
          "label": "@language.ita"
        },
        {
          "value": 6,
          "label": "@language.rus"
        }
      ],
      "label": "@language",
      "description": "@language.description",
      "page": "game",
      "control": [
        "dropdown",
        "cycler"
      ],
      "apply": "restart"
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@hudaspect.auto"
        }
      ],
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "label": "@hudaspect",
      "description": "@hudaspect.description",
      "page": "display",
      "group": "@group.hud",
      "apply": "live"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@NYC.FOVFactor",
      "description": "@NYC.FOVFactor.description",
      "page": "display",
      "apply": "live"
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@video.original"
        },
        {
          "value": 1,
          "label": "@video.fill"
        }
      ],
      "label": "@video",
      "description": "@video.description",
      "page": "display",
      "control": [
        "cycler",
        "dropdown"
      ],
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@borders.off"
        },
        {
          "value": 1,
          "label": "@borders.letter"
        },
        {
          "value": 2,
          "label": "@borders.pillar"
        },
        {
          "value": 3,
          "label": "@borders.both"
        }
      ],
      "label": "@borders",
      "description": "@borders.description",
      "page": "display",
      "control": [
        "cycler",
        "dropdown"
      ],
      "apply": "live",
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.AnimatedCutsceneBorders",
      "type": "bool",
      "default": true,
      "label": "@bordersanimated",
      "description": "@bordersanimated.description",
      "page": "display",
      "apply": "live"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "choice",
      "default": 60,
      "choices": [
        {
          "value": 30,
          "label": "30"
        },
        {
          "value": 60,
          "label": "60"
        }
      ],
      "label": "@fpslimit",
      "description": "@fpslimit.description",
      "page": "display",
      "group": "@group.framerate",
      "control": [
        "cycler",
        "dropdown"
      ],
      "apply": "live",
      "presets": {
        "vanilla": 30,
        "recommended": 60,
        "enhanced": 60
      }
    },
    {
      "id": "MAIN.RawInputMouse",
      "type": "bool",
      "default": true,
      "label": "@TCNYC.RawInputMouse",
      "description": "@TCNYC.RawInputMouse.description",
      "page": "controls",
      "apply": "restart"
    },
    {
      "id": "MAIN.MouseSensitivity",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.05,
      "decimals": 2,
      "unit": "x",
      "label": "@TCNYC.MouseSensitivity",
      "description": "@TCNYC.MouseSensitivity.description",
      "page": "controls",
      "apply": "live"
    },
    {
      "id": "MAIN.InvertMouseY",
      "type": "bool",
      "default": false,
      "label": "@TCNYC.InvertMouseY",
      "description": "@TCNYC.InvertMouseY.description",
      "page": "controls",
      "apply": "live",
      "enabledIf": {
        "setting": "MAIN.RawInputMouse",
        "equals": true
      }
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@confinecursor",
      "description": "@confinecursor.description",
      "page": "controls",
      "apply": "live"
    },
    {
      "id": "MOUSE.SensitivityFactor",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "decimals": 1,
      "unit": "x",
      "special": [
        {
          "value": 0,
          "label": "@sensfactor.game"
        }
      ],
      "label": "@sensfactor",
      "description": "@sensfactor.description",
      "page": "controls",
      "control": [
        "slider"
      ],
      "apply": "restart",
      "visibility": "editor"
    },
    {
      "id": "MISC.HighResolutionShadows",
      "type": "bool",
      "default": 1,
      "label": "@shadows",
      "description": "@shadows.description",
      "page": "graphics",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MISC.DistantBlur",
      "type": "bool",
      "default": 1,
      "label": "@distantblur",
      "description": "@distantblur.description",
      "page": "graphics",
      "group": "@group.postfx",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MISC.Bloom",
      "type": "bool",
      "default": 1,
      "label": "@bloom",
      "description": "@bloom.description",
      "page": "graphics",
      "group": "@group.postfx",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "GRAPHICS.AntiAliasing",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@off"
        },
        {
          "value": 1,
          "label": "SMAA"
        }
      ],
      "label": "@antialiasing",
      "description": "@antialiasing.description",
      "page": "graphics",
      "group": "@group.antialiasing",
      "control": [
        "cycler",
        "dropdown"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "GRAPHICS.ConsoleGamma",
      "type": "bool",
      "default": false,
      "label": "@consolegamma",
      "description": "@consolegamma.description",
      "page": "graphics",
      "group": "@group.postfx",
      "presets": {
        "vanilla": false,
        "recommended": false,
        "enhanced": true
      }
    }
  ]
}
