{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Peter Jackson's King Kong",
        "exe": [
          "KingKong8.exe",
          "KingKong9.exe",
          "KingKong9d.exe",
          "KingKongP.exe",
          "SettingsApplication.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ]
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "suggestions": [
        {
          "value": "Auto",
          "label": "@menu.auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.RawInputMouse",
      "type": "bool",
      "default": 1,
      "label": "@RawInputMouse",
      "description": "@RawInputMouse.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "advanced",
      "apply": "live",
      "visibility": "menu",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.0"
        },
        {
          "value": 1,
          "label": "@WindowMode.1"
        },
        {
          "value": 2,
          "label": "@WindowMode.2"
        }
      ]
    },
    {
      "id": "MAIN.VSync",
      "type": "bool",
      "default": 1,
      "label": "@VSync",
      "description": "@VSync.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": -1,
      "max": 1000
    },
    {
      "id": "MAIN.FPSLimitMode",
      "type": "int",
      "default": 2,
      "label": "@FPSLimitMode",
      "description": "@FPSLimitMode.description",
      "page": "compatibility",
      "apply": "live",
      "visibility": "file",
      "min": 1,
      "max": 2
    },
    {
      "id": "MAIN.MouseSensitivity",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.05,
      "decimals": 2,
      "label": "@MouseSensitivity",
      "description": "@MouseSensitivity.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": 1,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "advanced",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": 1,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "advanced",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": 0,
      "label": "@CheckForUpdates",
      "description": "@CheckForUpdates.description",
      "page": "compatibility",
      "apply": "live",
      "visibility": "menu"
    }
  ]
}
