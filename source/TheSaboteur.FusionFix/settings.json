{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "The Saboteur",
        "exe": [
          "Saboteur.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.fullscreen"
        },
        {
          "value": 1,
          "label": "@WindowMode.windowed"
        },
        {
          "value": 2,
          "label": "@WindowMode.borderless"
        }
      ],
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": 30,
      "max": 1000,
      "step": 1,
      "unit": "fps",
      "special": [
        {
          "value": 0,
          "label": "@fps.unlimited"
        },
        {
          "value": -1,
          "label": "@fps.monitor"
        }
      ],
      "suggestions": [
        {
          "value": 30
        },
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 240
        }
      ]
    },
    {
      "id": "GRAPHICS.AntiAliasing",
      "type": "choice",
      "default": 0,
      "label": "@AntiAliasing",
      "description": "@AntiAliasing.description",
      "page": "graphics",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 0,
        "enhanced": 1
      },
      "choices": [
        {
          "value": 0,
          "label": "@AntiAliasing.off"
        },
        {
          "value": 1,
          "label": "@AntiAliasing.smaa"
        }
      ]
    },
    {
      "id": "GRAPHICS.ConsoleGamma",
      "type": "bool",
      "default": false,
      "label": "@ConsoleGamma",
      "description": "@ConsoleGamma.description",
      "page": "graphics",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": false,
        "recommended": false,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@textlanguage",
      "description": "@textlanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "live"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "recommended": true,
        "enhanced": true,
        "vanilla": false
      }
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@checkupdates",
      "description": "@checkupdates.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": 0,
      "max": 1,
      "step": 1,
      "choices": [
        {
          "value": 0,
          "label": "@fmv.original"
        },
        {
          "value": 1,
          "label": "@fmv.fill"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.GamepadIcons",
      "type": "choice",
      "default": 0,
      "label": "@MAIN.GamepadIcons",
      "description": "@MAIN.GamepadIcons.description",
      "page": "display",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@menu.auto"
        },
        {
          "value": 1,
          "label": "Xbox"
        },
        {
          "value": 2,
          "label": "PlayStation"
        },
        {
          "value": 3,
          "label": "Nintendo"
        }
      ]
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2,
      "presets": {
        "vanilla": 1,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@MAIN.HudAspectRatioConstraint",
      "description": "@MAIN.HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "choices": [
        {
          "value": 0,
          "label": "@CutsceneBorders.off"
        },
        {
          "value": 1,
          "label": "@CutsceneBorders.letterbox"
        },
        {
          "value": 2,
          "label": "@CutsceneBorders.pillarbox"
        },
        {
          "value": 3,
          "label": "@CutsceneBorders.both"
        }
      ],
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      },
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    },
    {
      "id": "MAIN.AnimatedCutsceneBorders",
      "type": "bool",
      "default": 1,
      "label": "@AnimatedCutsceneBorders",
      "description": "@AnimatedCutsceneBorders.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu"
    }
  ]
}
