      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "CAMERA.FreeCamera",
      "type": "bool",
      "default": true,
      "label": "@CAMERA.FreeCamera",
      "description": "@CAMERA.FreeCamera.description",
      "page": "camera",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "CAMERA.CameraReturnTimeout",
      "type": "float",
      "default": 3.0,
      "label": "@CAMERA.CameraReturnTimeout",
      "description": "@CAMERA.CameraReturnTimeout.description",
      "page": "camera",
      "apply": "restart",
      "min": 0,
      "max": 60,
      "step": 0.1,
      "control": [
        "stepper"
      ],
      "enabledIf": {
        "setting": "CAMERA.FreeCamera",
        "equals": 1
      }
    },
    {
      "id": "CAMERA.CameraReturnSpeed",
      "type": "float",
      "default": 2.0,
      "label": "@CAMERA.CameraReturnSpeed",
      "description": "@CAMERA.CameraReturnSpeed.description",
      "page": "camera",
      "apply": "restart",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "control": [
        "stepper"
      ],
      "enabledIf": {
        "setting": "CAMERA.FreeCamera",
        "equals": 1
      }
    },
    {
