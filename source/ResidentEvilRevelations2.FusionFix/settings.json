{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Resident Evil Revelations 2",
        "exe": [
          "rerev2.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "graphics",
      "title": "@page.graphics",
      "section": "graphics"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2,
      "unit": "x",
      "label": "@fovfactor",
      "description": "@fovfactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "slider"
      ]
    },
    {
      "id": "MAIN.GamepadIcons",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@icons.auto"
        },
        {
          "value": 1,
          "label": "@icons.xbox"
        },
        {
          "value": 2,
          "label": "@icons.playstation"
        },
        {
          "value": 3,
          "label": "@icons.nintendo"
        }
      ],
      "label": "@icons",
      "description": "@icons.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@cutscene.off"
        },
        {
          "value": 1,
          "label": "@cutscene.letterbox"
        },
        {
          "value": 2,
          "label": "@cutscene.pillarbox"
        },
        {
          "value": 3,
          "label": "@cutscene.both"
        }
      ],
      "label": "@cutscene",
      "description": "@cutscene.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ],
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@hudaspect",
      "description": "@hudaspect.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "suggestions": [
        {
          "value": "Auto",
          "label": "@auto"
        },
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "21:9",
          "label": "21:9"
        },
        {
          "value": "32:9",
          "label": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 120,
      "min": -1,
      "max": 1000,
      "unit": "fps",
      "special": [
        {
          "value": -1,
          "label": "@fpslimit.refreshrate"
        },
        {
          "value": 0,
          "label": "@fpslimit.unlimited"
        }
      ],
      "suggestions": [
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 165
        },
        {
          "value": 240
        }
      ],
      "label": "@fpslimit",
      "description": "@fpslimit.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 2,
      "choices": [
        {
          "value": 1,
          "label": "@windowmode.windowed"
        },
        {
          "value": 2,
          "label": "@windowmode.borderless"
        }
      ],
      "label": "@windowmode",
      "description": "@windowmode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.SkipPressStart",
      "type": "bool",
      "default": 1,
      "label": "@SkipPressStart",
      "description": "@SkipPressStart.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.SplitScreenLayout",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@SplitScreenLayout.original"
        },
        {
          "value": 1,
          "label": "@SplitScreenLayout.topbottom"
        },
        {
          "value": 2,
          "label": "@SplitScreenLayout.sidebyside"
        }
      ],
      "label": "@SplitScreenLayout",
      "description": "@SplitScreenLayout.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.SplitScreenSwapTopBottom",
      "type": "bool",
      "default": 0,
      "label": "@SplitScreenSwapTopBottom",
      "description": "@SplitScreenSwapTopBottom.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.DisableDamageOverlay",
      "type": "bool",
      "default": 0,
      "label": "@DisableDamageOverlay",
      "description": "@DisableDamageOverlay.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.DisableFilmGrain",
      "type": "bool",
      "default": 0,
      "label": "@DisableFilmGrain",
      "description": "@DisableFilmGrain.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.ForceLogo",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@ForceLogo.game"
        },
        {
          "value": 1,
          "label": "@ForceLogo.biohazard"
        },
        {
          "value": 2,
          "label": "@ForceLogo.registered"
        },
        {
          "value": 3,
          "label": "@ForceLogo.trademark"
        },
        {
          "value": 4,
          "label": "@ForceLogo.registered2"
        }
      ],
      "label": "@ForceLogo",
      "description": "@ForceLogo.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.LightSyncRGB",
      "type": "bool",
      "default": 1,
      "label": "@LightSyncRGB",
      "description": "@LightSyncRGB.description",
      "page": "graphics",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.DisableFade",
      "type": "bool",
      "default": 0,
      "label": "@DisableFade",
      "description": "@DisableFade.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "live"
    },
    {
      "id": "MAIN.DisableCreateQuery",
      "type": "bool",
      "default": 0,
      "label": "@DisableCreateQuery",
      "description": "@DisableCreateQuery.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "restart"
    },
    {
      "id": "MAIN.DisableGUICommandFar",
      "type": "bool",
      "default": 0,
      "label": "@DisableGUICommandFar",
      "description": "@DisableGUICommandFar.description",
      "page": "compatibility",
      "visibility": "file",
      "apply": "live"
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@textlanguage",
      "description": "@textlanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "menu"
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@pauseonfocusloss",
      "description": "@pauseonfocusloss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@checkforupdates",
      "description": "@checkforupdates.description",
      "page": "compatibility",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
