{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "options",
      "title": "@page.options",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@skip",
      "description": "@skip.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.DualAnalogPatch",
      "type": "bool",
      "default": 1,
      "label": "@analog",
      "description": "@analog.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@loading",
      "description": "@loading.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@fov",
      "description": "@fov.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "MAIN.ForceAspectRatio",
      "type": "string",
      "default": "Auto",
      "label": "@aspect",
      "description": "@aspect.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14,
      "label": "@hudaspect",
      "description": "@hudaspect.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.HudScale",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "label": "@hudscale",
      "description": "@hudscale.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@borders.off"
        },
        {
          "value": 1,
          "label": "@borders.letterbox"
        },
        {
          "value": 2,
          "label": "@borders.pillarbox"
        },
        {
          "value": 3,
          "label": "@borders.both"
        }
      ],
      "label": "@borders",
      "description": "@borders.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "@auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ],
      "label": "@language",
      "description": "@language.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "restart"
    },
    {
      "id": "MAIN.GamepadIcons",
      "type": "choice",
      "default": 0,
      "label": "@icons",
      "description": "@icons.description",
      "page": "options",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@icons.auto"
        },
        {
          "value": 1,
          "label": "@icons.xbox"
        },
        {
          "value": 2,
          "label": "@icons.ps"
        },
        {
          "value": 3,
          "label": "@icons.nintendo"
        }
      ],
      "presets": {
        "vanilla": 2,
        "recommended": 0,
        "enhanced": 0
      }
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "choice",
      "default": 60,
      "label": "@fps",
      "description": "@fps.description",
      "page": "options",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 30,
          "label": "@fps.30"
        },
        {
          "value": 60,
          "label": "@fps.60"
        }
      ],
      "presets": {
        "vanilla": 30,
        "recommended": 60,
        "enhanced": 60
      }
    }
  ]
}
