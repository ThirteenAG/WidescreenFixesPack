    {
      "id": "MAIN.DualAnalogPatch",
      "type": "bool",
      "default": 1,
      "label": "@DualAnalogPatch",
      "description": "@DualAnalogPatch.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@UnthrottleEmuDuringLoading",
      "description": "@UnthrottleEmuDuringLoading.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
