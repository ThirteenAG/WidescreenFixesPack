{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "controls",
