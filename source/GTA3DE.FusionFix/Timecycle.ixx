            const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
            const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
            constexpr std::array<Storage, 31> storage{Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Integer, Storage::Float, Storage::Integer, Storage::Integer, Storage::Float, Storage::Float, Storage::Float};
            for (size_t column = 0; column < tables.size(); ++column)
            {
