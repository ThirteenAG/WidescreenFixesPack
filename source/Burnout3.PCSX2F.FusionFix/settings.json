{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    }
  ],
  "settings": [
    {
      "id": "MAIN.ForceAspectRatio",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14,
      "label": "@ForceAspectRatio",
      "description": "@ForceAspectRatio.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14,
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.HudScale",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "label": "@HudScale",
      "description": "@HudScale.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@fmv.original"
        },
        {
          "value": 1,
          "label": "@fmv.fill"
        }
