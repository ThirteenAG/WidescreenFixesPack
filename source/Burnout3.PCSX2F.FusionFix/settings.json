      "min": 0.1,
      "max": 5.0,
      "step": 0.05,
      "label": "@MouseSensitivity",
      "description": "@MouseSensitivity.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.InvertMouseY",
      "type": "bool",
      "default": false,
      "label": "@InvertMouseY",
      "description": "@InvertMouseY.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.GamepadCameraSpeed",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.05,
      "label": "@GamepadCameraSpeed",
      "description": "@GamepadCameraSpeed.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.InvertGamepadY",
      "type": "bool",
      "default": false,
      "label": "@InvertGamepadY",
      "description": "@InvertGamepadY.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
