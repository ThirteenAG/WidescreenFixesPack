      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "choice",
      "default": 60,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        {
          "value": 30,
          "label": "@fps.original"
        },
        {
          "value": 60,
          "label": "@fps.60"
        }
      ],
      "presets": {
        "vanilla": 30,
        "recommended": 60,
        "enhanced": 60
      }
    }
  ]
}
