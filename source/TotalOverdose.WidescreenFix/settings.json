{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Total Overdose",
        "exe": [
          "TOD.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "game",
      "title": "@page.game",
      "section": "gameplay"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    }
  ],
  "settings": [
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "game",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@FMVWidescreenMode.original"
        },
        {
          "value": 1,
          "label": "@FMVWidescreenMode.fill"
        },
        {
          "value": 2,
          "label": "@FMVWidescreenMode.stretch"
        }
      ],
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "game",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    }
  ]
}
