{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Call of Cthulhu: Dark Corners of the Earth",
        "exe": [
          "CoCMainWin32.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.0"
        },
        {
          "value": 1,
          "label": "@WindowMode.1"
        },
        {
          "value": 2,
          "label": "@WindowMode.2"
        }
      ]
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "gameplay",
      "apply": "live"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "gameplay",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.StretchFullscreenImages",
      "type": "bool",
      "default": 1,
      "label": "@StretchFullscreenImages",
      "description": "@StretchFullscreenImages.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": 1,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "display",
      "apply": "live",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@FMVWidescreenMode.0"
        },
        {
          "value": 1,
          "label": "@FMVWidescreenMode.1"
        },
        {
          "value": 2,
          "label": "@FMVWidescreenMode.2"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ]
    }
  ]
}
