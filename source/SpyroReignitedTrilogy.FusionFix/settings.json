{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Spyro Reignited Trilogy",
        "exe": [
          "Falcon/Binaries/Win64/Spyro-Win64-Shipping.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    }
  ],
  "settings": [
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "apply": "live",
      "visibility": "menu",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "decimals": 2
    },
    {
      "id": "MAIN.OverrideFOV",
      "type": "float",
      "default": -1.0,
      "label": "@OverrideFOV",
      "description": "@OverrideFOV.description",
      "page": "camera",
      "apply": "live",
      "visibility": "editor",
      "min": -1,
      "max": 179,
      "unit": "°",
      "special": [
        {
          "value": -1,
          "label": "@OverrideFOV.off"
        }
      ]
    }
  ]
}
