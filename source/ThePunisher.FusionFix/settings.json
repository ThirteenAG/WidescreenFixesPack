{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "The Punisher",
        "exe": [
          "pun.exe",
          "punisher.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@TextLanguage",
      "description": "@TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "choices": [
        { "value": "auto", "label": "@auto" },
        { "value": "en", "label": "English" },
        { "value": "fr", "label": "Français" },
        { "value": "de", "label": "Deutsch" },
        { "value": "it", "label": "Italiano" },
        { "value": "es", "label": "Español" }
      ]
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.fullscreen"
        },
        {
          "value": 1,
          "label": "@WindowMode.windowed"
        },
        {
          "value": 2,
          "label": "@WindowMode.borderless"
        }
      ],
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart"
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "choices": [
        {
          "value": 0,
          "label": "@borders.off"
        },
        {
          "value": 1,
          "label": "@borders.letter"
        },
        {
          "value": 2,
          "label": "@borders.pillar"
        },
        {
          "value": 3,
          "label": "@borders.both"
        }
      ],
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.AnimatedCutsceneBorders",
      "type": "bool",
      "default": true,
      "label": "@AnimatedCutsceneBorders",
      "description": "@AnimatedCutsceneBorders.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        }
      ],
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "control": [
        "cycler"
      ]
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "advanced",
      "apply": "live",
      "visibility": "menu",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "MAIN.RawInputMouse",
      "type": "bool",
      "default": true,
      "label": "@RawInputMouse",
      "description": "@RawInputMouse.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "live",
      "presets": { "vanilla": false, "recommended": true, "enhanced": true }
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "visibility": "menu",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "min": -1,
      "max": 1000,
      "step": 1,
      "presets": {
        "vanilla": 0,
        "recommended": 60,
        "enhanced": 60
      },
      "unit": "fps",
      "special": [
        {
          "value": 0,
          "label": "@fpslimit.unlimited"
        },
        {
          "value": -1,
          "label": "@fpslimit.refreshrate"
        }
      ],
      "suggestions": [
        {
          "value": 30
        },
        {
          "value": 60
        },
        {
          "value": 120
        },
        {
          "value": 144
        },
        {
          "value": 165
        },
        {
          "value": 240
        }
      ],
      "control": [
        "cycler",
        "dropdown"
      ]
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@checkupdates",
      "description": "@checkupdates.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
