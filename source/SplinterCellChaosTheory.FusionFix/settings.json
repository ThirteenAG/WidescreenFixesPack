      "apply": "live",
      "visibility": "menu",
      "choices": [
        {
          "value": 0,
          "label": "@FMVWidescreenMode.0"
        },
        {
          "value": 1,
          "label": "@FMVWidescreenMode.1"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
