{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.Enable60FPS",
      "type": "bool",
      "default": 1,
      "label": "@Enable60FPS",
      "description": "@Enable60FPS.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@UnthrottleEmuDuringLoading",
      "description": "@UnthrottleEmuDuringLoading.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "auto",
      "label": "@constraint",
      "description": "@constraint.description",
      "page": "display",
      "visibility": "editor",
      "apply": "restart",
      "maxLength": 14,
      "suggestions": [
        "auto",
        "4:3",
        "16:9",
        "21:9",
        "32:9"
      ]
    }
  ]
}
