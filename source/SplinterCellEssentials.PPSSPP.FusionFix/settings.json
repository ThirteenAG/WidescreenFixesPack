{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.StickDeadzone",
      "type": "float",
      "default": 0.1,
      "label": "@StickDeadzone",
      "description": "@StickDeadzone.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "min": 0,
      "max": 0.95,
      "step": 0.05
    },
    {
      "id": "MAIN.SpeedStickControl",
      "type": "bool",
      "default": 1,
      "label": "@SpeedStickControl",
      "description": "@SpeedStickControl.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "choice",
      "default": 60,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        { "value": 30, "label": "30 FPS" },
        { "value": 60, "label": "60 FPS" }
      ],
      "presets": {
        "vanilla": 30,
        "recommended": 60,
        "enhanced": 60
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@UnthrottleEmuDuringLoading",
      "description": "@UnthrottleEmuDuringLoading.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14
    },
    {
      "id": "MAIN.HudScale",
      "type": "float",
      "default": 1,
      "label": "@HudScale",
      "description": "@HudScale.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "min": 0.5,
      "max": 1.5,
      "step": 0.05
    },
    {
      "id": "MAIN.ForceAspectRatio",
      "type": "string",
      "default": "Auto",
      "label": "@ForceAspectRatio",
      "description": "@ForceAspectRatio.description",
      "page": "display",
      "visibility": "editor",
      "apply": "live",
      "special": [
        {
          "value": "Auto",
          "label": "@auto"
        }
      ],
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "maxLength": 14
    }
  ]
}
