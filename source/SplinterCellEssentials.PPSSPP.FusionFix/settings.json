{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100
  },
  "pages": [
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    }
  ],
  "settings": [
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.StickDeadzone",
      "type": "float",
      "default": 0.1,
      "label": "@StickDeadzone",
      "description": "@StickDeadzone.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0.1,
        "recommended": 0.1,
        "enhanced": 0.1
      },
      "min": 0,
      "max": 0.95,
      "step": 0.05
    },
    {
      "id": "MAIN.SpeedStickControl",
      "type": "bool",
      "default": 1,
      "label": "@SpeedStickControl",
      "description": "@SpeedStickControl.description",
      "page": "controls",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.Enable60FPS",
      "type": "bool",
      "default": 1,
      "label": "@Enable60FPS",
      "description": "@Enable60FPS.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.UnthrottleEmuDuringLoading",
      "type": "bool",
      "default": 1,
      "label": "@UnthrottleEmuDuringLoading",
      "description": "@UnthrottleEmuDuringLoading.description",
      "page": "gameplay",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      },
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    },
    {
      "id": "MAIN.ContainFullscreenImages",
      "type": "bool",
      "default": 1,
      "label": "@ContainFullscreenImages",
      "description": "@ContainFullscreenImages.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.HudScale",
      "type": "float",
      "default": 1,
      "label": "@HudScale",
      "description": "@HudScale.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": 1,
        "recommended": 1,
        "enhanced": 1
      },
      "min": 0.5,
      "max": 1.5,
      "step": 0.05
    }
  ]
}
