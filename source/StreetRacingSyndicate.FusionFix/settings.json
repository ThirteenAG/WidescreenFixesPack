{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Street Racing Syndicate",
        "exe": [
          "srs.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "visibility": "editor",
      "apply": "menu",
      "choices": [
        { "value": "auto", "label": "@MAIN.TextLanguage.auto" },
        { "value": "en", "label": "English" },
        { "value": "fr", "label": "Français" },
        { "value": "de", "label": "Deutsch" },
        { "value": "it", "label": "Italiano" },
        { "value": "es", "label": "Español" }
      ]
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@WindowMode.0"
        },
        {
          "value": 1,
          "label": "@WindowMode.1"
        },
        {
          "value": 2,
          "label": "@WindowMode.2"
        }
      ]
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto",
          "label": "@HudAspectRatioConstraint.auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@FMVWidescreenMode",
      "description": "@FMVWidescreenMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@FMVWidescreenMode.0"
        },
        {
          "value": 1,
          "label": "@FMVWidescreenMode.1"
        }
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 3,
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "choices": [
        {
          "value": 0,
          "label": "@CutsceneBorders.0"
        },
        {
          "value": 1,
          "label": "@CutsceneBorders.1"
        },
        {
          "value": 2,
          "label": "@CutsceneBorders.2"
        },
        {
          "value": 3,
          "label": "@CutsceneBorders.3"
        }
      ],
      "presets": {
        "vanilla": 1,
        "recommended": 3,
        "enhanced": 3
      }
    },
    {
      "id": "MAIN.AnimatedCutsceneBorders",
      "type": "bool",
      "default": true,
      "label": "@AnimatedCutsceneBorders",
      "description": "@AnimatedCutsceneBorders.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.SkipPressStart",
      "type": "bool",
      "default": true,
      "label": "@SkipPressStart",
      "description": "@SkipPressStart.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@ConfineCursor",
      "description": "@ConfineCursor.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@CheckForUpdates",
      "description": "@CheckForUpdates.description",
      "page": "advanced",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "advanced",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "advanced",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384
    }
  ]
}
