{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Knight Rider: The Game",
        "exe": [
          "Knight Rider.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "camera",
      "title": "@page.camera",
      "section": "camera"
    },
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "controller",
      "title": "@page.controller",
      "section": "gameplay"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@FOVFactor",
      "description": "@FOVFactor.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@ResX",
      "description": "@ResX.description",
      "page": "display",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@ResY",
      "description": "@ResY.description",
      "page": "display",
      "visibility": "editor",
      "apply": "restart",
      "min": 0,
      "max": 16384
    },
    {
      "id": "MAIN.PauseOnFocusLoss",
      "type": "bool",
      "default": true,
      "label": "@PauseOnFocusLoss",
      "description": "@PauseOnFocusLoss.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@WindowMode",
      "description": "@WindowMode.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@Fullscreen"
        },
        {
          "value": 1,
          "label": "@Windowed"
        },
        {
          "value": 2,
          "label": "@Borderless"
        }
      ]
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.SkipPressStart",
      "type": "bool",
      "default": true,
      "label": "@SkipPressStart",
      "description": "@SkipPressStart.description",
      "page": "display",
      "visibility": "menu",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@HudAspectRatioConstraint",
      "description": "@HudAspectRatioConstraint.description",
      "page": "display",
      "visibility": "menu",
      "apply": "live",
      "suggestions": [
        {
          "value": "Auto",
          "label": "@HudAspectRatioConstraint.auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ]
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@MAIN.ConfineCursor",
      "description": "@MAIN.ConfineCursor.description",
      "page": "display",
      "apply": "live",
      "visibility": "editor"
    },
    {
      "id": "MAIN.FPSLimit",
      "type": "int",
      "default": 60,
      "min": -1,
      "max": 1000,
      "step": 1,
      "label": "@FPSLimit",
      "description": "@FPSLimit.description",
      "page": "display",
      "apply": "live",
      "visibility": "menu",
      "presets": {
        "vanilla": 0,
        "recommended": 60,
        "enhanced": 60
      }
    },
    {
      "id": "MAIN.CutsceneBorders",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@CutsceneBorders.0"
        },
        {
          "value": 1,
          "label": "@CutsceneBorders.1"
        }
      ],
      "label": "@CutsceneBorders",
      "description": "@CutsceneBorders.description",
      "page": "camera",
      "visibility": "menu",
      "apply": "live"
    },
    {
      "id": "MAIN.CheckForUpdates",
      "type": "bool",
      "default": false,
      "label": "@CheckForUpdates",
      "description": "@CheckForUpdates.description",
      "page": "display",
      "visibility": "editor",
      "apply": "live"
    },
    {
      "id": "MAIN.GamepadIcons",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@menu.auto"
        },
        {
          "value": 1,
          "label": "Xbox"
        },
        {
          "value": 2,
          "label": "PlayStation"
        },
        {
          "value": 3,
          "label": "Nintendo"
        }
      ],
      "label": "@GamepadIcons",
      "description": "@GamepadIcons.description",
      "page": "controller",
      "visibility": "menu",
      "apply": "live"
    }
  ]
}
