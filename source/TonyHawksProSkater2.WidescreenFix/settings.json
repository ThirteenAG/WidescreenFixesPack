{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "@plugin.name",
    "priority": 100,
    "games": [
      {
        "name": "Tony Hawk Pro Skater 2",
        "exe": [
          "THawk2.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "advanced",
      "title": "@page.advanced",
      "section": "advanced"
    },
    {
      "id": "compatibility",
      "title": "@page.compatibility",
      "section": "compatibility"
    },
    {
      "id": "gameplay",
      "title": "@page.gameplay",
      "section": "gameplay"
    }
  ],
  "settings": [
    {
      "id": "MAIN.TextLanguage",
      "type": "choice",
      "default": "auto",
      "label": "@MAIN.TextLanguage",
      "description": "@MAIN.TextLanguage.description",
      "page": "compatibility",
      "apply": "menu",
      "visibility": "editor",
      "choices": [
        {
          "value": "auto",
          "label": "@menu.auto"
        },
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        },
        {
          "value": "de",
          "label": "Deutsch"
        },
        {
          "value": "it",
          "label": "Italiano"
        },
        {
          "value": "es",
          "label": "Español"
        }
      ]
    },
    {
      "id": "MAIN.ResX",
      "type": "int",
      "default": 0,
      "label": "@MAIN.ResX",
      "description": "@MAIN.ResX.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.ResY",
      "type": "int",
      "default": 0,
      "label": "@MAIN.ResY",
      "description": "@MAIN.ResY.description",
      "page": "advanced",
      "apply": "restart",
      "visibility": "editor",
      "min": 0,
      "max": 16384,
      "step": 1
    },
    {
      "id": "MAIN.FixHUD",
      "type": "bool",
      "default": true,
      "label": "@MAIN.FixHUD",
      "description": "@MAIN.FixHUD.description",
      "page": "display",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": true,
      "label": "@SkipIntro",
      "description": "@SkipIntro.description",
      "page": "display",
      "apply": "restart",
      "presets": {
        "vanilla": false,
        "recommended": true,
        "enhanced": true
      }
    },
    {
      "id": "MAIN.FOVFactor",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "label": "@MAIN.FOVFactor",
      "description": "@MAIN.FOVFactor.description",
      "page": "gameplay",
      "apply": "live",
      "presets": {
        "vanilla": 1.0,
        "recommended": 1.0,
        "enhanced": 1.0
      }
    },
    {
      "id": "MAIN.WindowMode",
      "type": "choice",
      "default": 0,
      "label": "@MAIN.WindowMode",
      "description": "@MAIN.WindowMode.description",
      "page": "display",
      "apply": "restart",
      "choices": [
        {
          "value": 0,
          "label": "@MAIN.WindowMode.0"
        },
        {
          "value": 1,
          "label": "@MAIN.WindowMode.1"
        },
        {
          "value": 2,
          "label": "@MAIN.WindowMode.2"
        }
      ]
    },
    {
      "id": "MAIN.FMVWidescreenMode",
      "type": "choice",
      "default": 1,
      "label": "@MAIN.FMVWidescreenMode",
      "description": "@MAIN.FMVWidescreenMode.description",
      "page": "display",
      "apply": "live",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      },
      "choices": [
        {
          "value": 0,
          "label": "@MAIN.FMVWidescreenMode.0"
        },
        {
          "value": 1,
          "label": "@MAIN.FMVWidescreenMode.1"
        },
        {
          "value": 2,
          "label": "@MAIN.FMVWidescreenMode.2"
        }
      ]
    },
    {
      "id": "MAIN.HudAspectRatioConstraint",
      "type": "string",
      "default": "Auto",
      "label": "@MAIN.HudAspectRatioConstraint",
      "description": "@MAIN.HudAspectRatioConstraint.description",
      "page": "display",
      "apply": "live",
      "presets": {
        "vanilla": "Auto",
        "recommended": "Auto",
        "enhanced": "Auto"
      },
      "suggestions": [
        {
          "value": "Auto"
        },
        {
          "value": "4:3"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ]
    },
    {
      "id": "MAIN.ConfineCursor",
      "type": "bool",
      "default": true,
      "label": "@MAIN_ConfineCursor",
      "description": "@MAIN_ConfineCursor.description",
      "page": "display",
      "visibility": "editor",
      "apply": "live"
    }
  ]
}
