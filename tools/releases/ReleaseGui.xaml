<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widescreen Fixes Pack · Releases" Width="1320" Height="860" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF" FontFamily="Segoe UI" FontSize="13"
        Foreground="#202020" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F3F3F3"/><Setter Property="Foreground" Value="#262626"/>
      <Setter Property="BorderBrush" Value="#E7E7E7"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#BEBEBE" Background="White">
            <Path x:Name="Mark" Data="M 4,8 L 7,11 L 13,5" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#171717"/><Setter TargetName="Box" Property="BorderBrush" Value="#171717"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#404040"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E7E7E7"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="White">
    <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F5F5F5" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0">
      <Grid Margin="18,25,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,28">
          <TextBlock Text="Widescreen Fixes" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Release workspace" Foreground="#858585" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="Platforms" Foreground="#888888" Margin="10,0,0,10" FontSize="12"/>
          <ListBox x:Name="Categories" BorderThickness="0" Background="Transparent" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="11,11"/><Setter Property="Margin" Value="0,2"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Item" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#EBEBEB"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E3E3E3"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
          </ListBox>
          <Button x:Name="SelectAll" Content="Select all releases" Margin="0,24,0,8" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="#DDDDDD"/>
          <Button x:Name="ClearAll" Content="Clear selection" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="One run. Your selection.&#10;Signing happens in GitHub Actions." Foreground="#888888" FontSize="11" LineHeight="18" TextWrapping="Wrap" Margin="9,18,0,0"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,24,28,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Releases" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Choose the fixes you want to publish." Foreground="#808080" Margin="0,7,0,0"/></StackPanel>
        <Button x:Name="SignIn" Grid.Column="1" Content="Sign in to GitHub" VerticalAlignment="Top" Background="White"/>
      </Grid>
      <Border Grid.Row="1" BorderBrush="#E9E9E9" BorderThickness="1" CornerRadius="13" Padding="17,14" Margin="0,0,0,24">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0"><TextBlock Text="Repository" Foreground="#868686" FontSize="11" Margin="0,0,0,7"/><TextBox x:Name="Repo" FontSize="13"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="Source branch or tag" Foreground="#868686" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="Ref" IsEditable="True" Background="White" BorderThickness="0" Padding="0,3" Text="master"/></StackPanel>
          <Button x:Name="Connect" Grid.Column="2" Content="Connect" VerticalAlignment="Center" Background="#F4F4F4" BorderBrush="Transparent"/>
          <TextBlock x:Name="Connection" Grid.Row="1" Grid.ColumnSpan="3" Text="Uses your GitHub CLI login." Foreground="#969696" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="#E7E7E7" BorderThickness="1" CornerRadius="10" Padding="13,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="⌕" FontSize="20" Foreground="#888888" VerticalAlignment="Center"/>
              <Grid Grid.Column="1"><TextBox x:Name="Search" Background="Transparent"/><TextBlock x:Name="SearchHint" Text="Search releases, tags or plugins" Foreground="#A0A0A0" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="SelectShown" Content="Select shown" FontSize="12" Padding="10,6" Background="White" BorderBrush="Transparent"/>
            <Button x:Name="ClearShown" Grid.Column="1" Content="Clear shown" FontSize="12" Padding="10,6" Background="White" BorderBrush="Transparent" Foreground="#888888"/>
            <CheckBox x:Name="SelectedOnly" Grid.Column="2" Content="Only selected" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
          <ListBox x:Name="Releases" Grid.Row="2" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,12"/><Setter Property="Margin" Value="0,2"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" CornerRadius="9" Background="White" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F7F7F7"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F0"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" IsEnabled="{Binding available}" VerticalAlignment="Center" ToolTip="Select this release"/>
                <StackPanel Grid.Column="1" Margin="7,0,12,0"><TextBlock Text="{Binding name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding name}"/><TextBlock Text="{Binding tag}" Foreground="#929292" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                <Border Grid.Column="2" CornerRadius="6" Background="#F5F5F5" Padding="7,4" VerticalAlignment="Center"><TextBlock Text="{Binding PlatformLabel}" FontSize="10" Foreground="#777777" ToolTip="{Binding PlatformDetail}"/></Border>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Column="2" CornerRadius="13" BorderBrush="#EAEAEA" BorderThickness="1" Background="#FCFCFC" Padding="17">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
            <TextBlock Text="Your selection" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBox x:Name="Review" Grid.Row="1" IsReadOnly="True" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="12" Foreground="#686868"/>
            <TextBlock Grid.Row="2" Text="Release details" FontSize="12" Foreground="#888888" Margin="0,19,0,12"/>
            <TextBox x:Name="Detail" Grid.Row="3" IsReadOnly="True" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="11" Foreground="#777777"/>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="3" Margin="0,24,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock x:Name="Count" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="Status" Text="Select releases to get started." Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenRun" Content="Open run ↗" Background="White" Margin="0,0,10,0" IsEnabled="False"/>
          <Button x:Name="Publish" Content="Publish releases →" Background="#171717" Foreground="White" BorderBrush="#171717" Padding="20,12" IsEnabled="False" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
