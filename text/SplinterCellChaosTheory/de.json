  "ResX": "Auflösungsbreite",
  "ResX.description": "0 wählt die Desktopauflösung. Zum Überschreiben beide Abmessungen setzen.",
  "ResY": "Auflösungshöhe",
  "ResY.description": "0 wählt die Desktopauflösung. Zum Überschreiben beide Abmessungen setzen.",
  "RawInputMouse": "Direkte Mauseingabe",
  "RawInputMouse.description": "Erfasst Mausbewegungen unabhängig vom Rendern, um Eingabeverluste zu vermeiden. Neustart erforderlich.",
  "RawInputMouseRawData": "Unbeschleunigte Mauseingabe",
  "RawInputMouseRawData.description": "Ignoriert Windows-Zeigergeschwindigkeit und -Beschleunigung für rohe Mausbewegungen. Neustart erforderlich.",
  "HudAspectRatioConstraint": "HUD-Seitenverhältnis",
  "HudAspectRatioConstraint.description": "Auto setzt das HUD an die Bildschirmränder. Ein Verhältnis wie 4:3, 16:9 oder 21:9 hält es in einem mittigen Rahmen; 4:3 ist das Original-Layout. Wirkt sofort.",
  "SkipIntro": "Intro-Logos überspringen",
  "SkipIntro.description": "Überspringt Intro-Logos wie der native Parameter -nointro.",
  "SkipPressStart": "Startaufforderung überspringen",
  "SkipPressStart.description": "Überspringt die anfängliche Beliebige-Taste-Aufforderung.",
  "WindowMode": "Fenstermodus",
  "WindowMode.description": "Vollbild, Fenster mit gewählter Auflösung oder randlos über den Monitor. Bei Desktopauflösung liegt der Rahmen außerhalb. Alt+Enter wechselt die Modi.",
  "WindowMode.0": "Vollbild",
  "WindowMode.1": "Fenster",
  "WindowMode.2": "Randlos",
  "FullScreenRefreshRateInHz": "Vollbild-Bildwiederholrate",
  "FullScreenRefreshRateInHz.description": "Nutzt die höchste Vollbild-Bildwiederholrate bis zu diesem Wert für die Auflösung. 0 nutzt den Adapterstandard.",
  "ShadowMapResolution": "Schattenkarten-Auflösung",
  "ShadowMapResolution.description": "Schattenkartengröße: 2048, 3072, 4096, 5120, 6144, 7168, 8192 oder 16384. 0 und 2048 behalten das Original; höhere Werte belasten GPU und Speicher stärker.",
  "EnableShadowFiltering": "Schatten filtern",
  "EnableShadowFiltering.description": "Glättet winkelabhängige Schatten. Ohne diese Option werden weiche Schatten weniger weich. Die Filterung kann bei mehreren Monitoren Probleme verursachen.",
  "FPSLimit": "Bildratenbegrenzung",
  "FPSLimit.description": "Begrenzt die native Bildrate. 0 hebt die Begrenzung auf; -1 folgt der Bildwiederholrate des aktuellen Monitors. Wirkt sofort. Die Vorgabe von 60 FPS vermeidet Spielprobleme bei hohen Bildraten.",
  "BlacklistIndicators": "Anzeigenverhalten",
  "BlacklistIndicators.description": "Leuchten im Schatten lässt Sams Anzeigen wie in Blacklist arbeiten: dunkel im Licht, leuchtend im Schatten und schwächer, je sichtbarer du bist. Leuchten im Licht kehrt das um.",
  "BlacklistIndicators.0": "Original",
  "BlacklistIndicators.1": "Leuchten im Schatten",
  "BlacklistIndicators.2": "Leuchten im Licht",
  "GogglesLightColor": "Leuchtfarbe der Brille",
  "GogglesLightColor.description": "Original behält die Lichter des Spiels. Die anderen Farben sind die Ops-Anzug-Lichtfarben aus Blacklist. Neustart erforderlich.",
  "LightSyncRGB": "Logitech-Lichtsynchronisierung",
  "LightSyncRGB.description": "Synchronisiert unterstützte Logitech-RGB-Geräte mit Spielereignissen. Logitech G HUB erforderlich.",
